/* 4 · Cinta en loop */
.tick{overflow:hidden;background:var(--saw);color:var(--sawink);padding:13px 0;margin-top:40px}
.tick div{display:flex;width:max-content;animation:tk 32s linear infinite}
.tick span{display:inline-flex;align-items:center;gap:22px;padding-right:22px;font:700 17px/1 var(--display);letter-spacing:.02em;white-space:nowrap}
