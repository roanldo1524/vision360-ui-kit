      <button class="cta js-order rv" type="button">Pedir mi afilador</button>
      <p class="micro">Pagas al recibir · Te confirmamos por WhatsApp</p>
    </div>
  </section>
  <div style="height:72px;background:var(--bark)"></div>

  <!-- Barra fija -->
  <div class="sk" id="sticky" aria-hidden="true">
    <div class="sk-l"><b id="stName">1 afilador</b><span>Pagas al recibir · Envío gratis</span></div>
    <button class="cta js-order" type="button" id="stBtn" tabindex="-1">Pedir · {{ k1 | times: 100 | money_without_trailing_zeros }}</button>
  </div>
</div>
</template>
<script>
(function(){
const host=document.getElementById('fl-host');if(!host||host.shadowRoot)return;
const root=host.attachShadow({mode:'open'});root.appendChild(document.getElementById('fl-tpl').content.cloneNode(true));
const $=s=>root.querySelector(s),$$=s=>[...root.querySelectorAll(s)];
const RM=matchMedia('(prefers-reduced-motion: reduce)').matches;
const P={1:{{ k1 }},2:{{ k2 }}},ANTES={{ antes }};
const fmt=n=>'$'+Math.round(n).toLocaleString('es-CO');
let kit=1;
/* Elegir cantidad */
const setKit=k=>{kit=k;$$('.kit').forEach(b=>{const on=+b.dataset.k===k;b.classList.toggle('on',on);b.setAttribute('aria-checked',on)});
  const p=P[k],was=k===1?ANTES:P[1]*2;$('#pNow').textContent=fmt(p);$('#pWas').textContent=fmt(was);$('#pOff').textContent='Ahorras '+fmt(was-p);
  $('#kitName').textContent=k===1?'1 afilador':'2 afiladores';$('#btnTxt').textContent=k===1?'Pedir mi afilador':'Pedir mis 2 afiladores';$('#btnPrice').textContent=fmt(p);
  $('#stName').textContent=k===1?'1 afilador':'2 afiladores';$('#stBtn').textContent='Pedir · '+fmt(p)};
$$('.kit').forEach(b=>b.addEventListener('click',()=>setKit(+b.dataset.k)));
/* Abrir EasySell con la cantidad elegida */
function order(e){if(e)e.preventDefault();
  const es=document.getElementById('es-sticky')||document.querySelector('.es-button:not(.js-order),[data-es-button]');
  if(es){es.click();let n=0;(function pick(){const qo=document.querySelectorAll('.es-modal .es-qo-container');if(qo[kit-1]){qo[kit-1].click()}else if(n++<30){setTimeout(pick,150)}})();return}
  const f=document.getElementById('fl-product-form');if(f){f.querySelector('[name=quantity]').value=kit;f.submit()}
}
root.addEventListener('click',e=>{const b=e.target.closest('.js-order');if(b)order(e)},true);
/* Galería */
const slides=$('#slides'),th=$$('#thumbs button'),gc=$('#gcount'),hv=$('#hov'),N=slides.children.length;
const gi=()=>Math.round(slides.scrollLeft/slides.clientWidth);
const gsync=()=>{const i=gi();hv.classList.toggle('off',i>0);gc.textContent=(i+1)+' / '+N;th.forEach((b,j)=>b.classList.toggle('on',i===j));
  const tb=th[i];if(tb){const tw=$('#thumbs');tw.scrollTo({left:tb.offsetLeft-tw.clientWidth/2+tb.clientWidth/2,behavior:RM?'auto':'smooth'})}
  [...slides.children].forEach((f,k)=>{const v=f.querySelector('video');if(!v)return;if(k===i){if(!v.src)v.src=v.dataset.src;v.play().catch(()=>{})}else v.pause()})};
const ggo=i=>slides.scrollTo({left:Math.max(0,Math.min(N-1,i))*slides.clientWidth,behavior:RM?'auto':'smooth'});
slides.addEventListener('scroll',()=>requestAnimationFrame(gsync),{passive:true});
th.forEach((b,j)=>b.addEventListener('click',()=>ggo(j)));
$('#gprev').addEventListener('click',()=>ggo(gi()-1));$('#gnext').addEventListener('click',()=>ggo(gi()+1));
/* Videos con sonido al tocar; se callan al salir de pantalla */
const vids=[[$('#vUso'),$('#vSnd'),'Toca para oír la explicación'],[$('#vCaja'),$('#vSnd2'),'Toca para oír']];
vids.forEach(([v,b,lbl])=>{if(!v)return;
  b.addEventListener('click',()=>{if(!v.src)v.src=v.dataset.src;const on=v.muted;vids.forEach(([o,ob,ol])=>{if(o&&o!==v){o.muted=true;ob.setAttribute('aria-pressed','false');ob.querySelector('span').textContent=ol}});v.muted=!on;if(on){v.currentTime=0;v.play().catch(()=>{})}b.setAttribute('aria-pressed',String(on));b.querySelector('span').textContent=on?'Silenciar':lbl});
  if('IntersectionObserver' in window)new IntersectionObserver(es=>{const x=es[0];if(x.isIntersecting){if(!v.src)v.src=v.dataset.src;v.play().catch(()=>{})}else{v.pause();if(!v.muted){v.muted=true;b.setAttribute('aria-pressed','false');b.querySelector('span').textContent=lbl}}},{threshold:.35}).observe(v)});
document.addEventListener('visibilitychange',()=>{if(document.hidden)vids.forEach(([v])=>v&&v.pause())});
/* Calculadora */
const cV=$('#cVeces'),cP=$('#cPrecio');
const calc=()=>{const v=+cV.value,p=+cP.value;$('#oVeces').textContent=v;$('#oPrecio').textContent=fmt(p);$('#rAno').textContent=fmt(v*p*12);$('#rPaga').textContent=Math.ceil(P[1]/p)};
cV.addEventListener('input',calc);cP.addEventListener('input',calc);calc();
/* Preguntas */
$$('.q button').forEach(b=>b.addEventListener('click',()=>{const q=b.parentElement,o=!q.classList.contains('open');q.classList.toggle('open',o);b.setAttribute('aria-expanded',o)}));
/* Frase que se revela palabra por palabra */
const tl=$('#tagline');if(tl){const ws=tl.textContent.trim().split(/\s+/);tl.innerHTML=ws.map(w=>'<span aria-hidden="true">'+w+'</span>').join(' ');const sp=[...tl.querySelectorAll('span')];
  if(RM||!('IntersectionObserver' in window))sp.forEach(s=>s.classList.add('on'));else{let raf=0;const upd=()=>{raf=0;const line=innerHeight*.72;sp.forEach(s=>s.classList.toggle('on',s.getBoundingClientRect().top<line))};
  new IntersectionObserver(es=>{if(es[0].isIntersecting){addEventListener('scroll',on,{passive:true});upd()}else removeEventListener('scroll',on)}).observe(tl);function on(){if(!raf)raf=requestAnimationFrame(upd)}}}
/* Barra fija */
const st=$('#sticky'),mb=$('#mainBtn');let mbVis=true;const upd2=()=>{st.classList.toggle('show',!mbVis&&scrollY>400&&innerWidth<900)};
new IntersectionObserver(es=>{mbVis=es[0].isIntersecting;upd2()}).observe(mb);addEventListener('scroll',upd2,{passive:true});
/* Entradas al hacer scroll */
if(!RM&&'IntersectionObserver' in window){$('#pg').classList.add('js');const io=new IntersectionObserver(es=>es.forEach(x=>{if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target)}}),{rootMargin:'0px 0px -8% 0px'});$$('.rv').forEach(el=>io.observe(el))}
})();
</script>
