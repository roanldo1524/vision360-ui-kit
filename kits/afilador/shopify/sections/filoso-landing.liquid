.calc input[type=range]::-moz-range-track{height:6px;border-radius:999px;background:rgba(255,255,255,.12)}
.calc input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:28px;height:28px;margin-top:-11px;border-radius:999px;background:var(--saw);border:4px solid var(--bark);box-shadow:0 0 0 2px var(--saw)}
.calc input[type=range]::-moz-range-thumb{width:22px;height:22px;border-radius:999px;background:var(--saw);border:4px solid var(--bark)}
.calc .res{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:22px}
