.vsnd{position:absolute;left:50%;bottom:18px;transform:translateX(-50%);display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 18px;border-radius:999px;background:rgba(0,0,0,.6);color:#fff;font:600 14px/1 var(--text);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);transition:transform 200ms var(--ease)}
.vsnd:active{transform:translateX(-50%) scale(.97)}
