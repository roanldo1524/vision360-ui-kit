.vid .w{display:grid;grid-template-columns:minmax(0,1fr);gap:28px}
.vcard{position:relative;border-radius:24px;overflow:hidden;background:#000;aspect-ratio:9/16;max-height:78vh;margin:0 auto;width:100%;max-width:440px;box-shadow:var(--sh2)}
