/* ====== Demo de voz ====== */
(()=>{const wv=$('#vWave'),btn=$('#vPlay'),cap=$('#vCap');
  for(let i=0;i<30;i++){const b=document.createElement('i');b.style.setProperty('--i',i);b.style.setProperty('--h',(8+Math.abs(Math.sin(i*1.3)*30)+Math.random()*8)+'px');wv.appendChild(b)}
  const L=['Hola, feliz cumpleaños.','Quería decirte esto con mi voz,','porque algunas cosas no caben en un mensaje.','Gracias por tanto. Te quiero.'];
  cap.innerHTML=L.map(t=>`<span>${t}</span>`).join('');const sp=[...cap.children];sp[0].textContent='Toca play para ver cómo se lee tu voz.';sp[0].classList.add('on');
  let on=false,timers=[];
