{% layout none %}{% raw %}<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#1A0D0E">
<title>Latido · Regala una sorpresa de cumpleaños con tu voz</title>
<meta name="description" content="Sube tu audio, escribe tu mensaje y en 20 minutos tienes una sorpresa de cumpleaños que se abre desde el celular. $15 USD.">
<meta property="og:title" content="Latido · Una sorpresa de cumpleaños que se abre con tu voz">
<meta property="og:description" content="Sube tu audio y tu mensaje. Nosotros armamos la sorpresa. $15 USD.">
<meta property="og:type" content="website">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Pinyon+Script&family=Young+Serif&family=Figtree:wght@400;500;600;700&display=swap">
<style>
:root{
  --ink:#1A0D0E;--ink2:#26141A;--rose:#FF5C93;--rose2:#FF8DB3;--gold:#F5CF72;
  --text:#F6EAF1;--soft:#C9B3C6;--mute:#9C849A;
  --line:rgba(255,255,255,.07);--glass:rgba(255,255,255,.04);--glass2:rgba(255,255,255,.07);
  --ease:cubic-bezier(.23,1,.32,1);--io:cubic-bezier(.77,0,.175,1);
  --display:'Young Serif',Georgia,serif;--sans:'Figtree',system-ui,sans-serif;--script:'Pinyon Script',cursive;
  --sh1:0 4px 20px -2px rgba(0,0,0,.28),0 2px 8px -1px rgba(0,0,0,.2);
  --sh2:0 30px 60px -15px rgba(0,0,0,.55),0 15px 30px -10px rgba(0,0,0,.35);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{background:var(--ink);color:var(--text);font:400 17px/1.6 var(--sans);-webkit-font-smoothing:antialiased;overflow-x:hidden}
button,input,textarea{font:inherit;color:inherit}
button{background:none;border:0;cursor:pointer;-webkit-tap-highlight-color:transparent;touch-action:manipulation}
img,svg,canvas{display:block;max-width:100%}
a{color:inherit}
:focus-visible{outline:2px solid var(--gold);outline-offset:3px;border-radius:10px}
.w{width:100%;max-width:1120px;margin:0 auto;padding:0 20px}
h1,h2,h3{font-family:var(--display);font-weight:400;letter-spacing:-.02em;line-height:1.06;text-wrap:balance}
h1{font-size:clamp(40px,11.4vw,76px)}
h2{font-size:clamp(30px,8.2vw,46px)}
h3{font-size:22px;letter-spacing:-.01em}
p{text-wrap:pretty}
.lead{color:var(--soft);font-size:18px;max-width:34em}
.tag{display:inline-block;font:700 11px/1 var(--sans);letter-spacing:.15em;text-transform:uppercase;color:var(--gold);padding:9px 14px;border-radius:99px;background:rgba(245,207,114,.1);border:1px solid rgba(245,207,114,.22)}
/* Botón principal */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:58px;padding:0 30px;border-radius:99px;background:var(--rose);color:#2A0A1B;font:700 18px/1 var(--sans);letter-spacing:.005em;text-decoration:none;transition:transform 160ms var(--ease),background-color 200ms ease,opacity 200ms ease;box-shadow:0 14px 30px -14px rgba(0,0,0,.55),0 4px 10px -4px rgba(0,0,0,.35);user-select:none;-webkit-user-select:none}
.btn:active{transform:scale(.97)}
@media (hover:hover) and (pointer:fine){.btn:hover{background:var(--rose2);transform:translateY(-1px)}.btn:hover:active{transform:scale(.97)}}
.btn.ghost{background:var(--glass2);color:var(--text);box-shadow:none;border:1px solid var(--line)}
.btn.sm{min-height:44px;padding:0 20px;font-size:15px}
.micro{margin-top:12px;font-size:13.5px;color:var(--mute)}
/* Barra superior */
.nav{position:absolute;top:0;left:0;right:0;z-index:5;padding:calc(14px + env(safe-area-inset-top)) 0 0}
.nav .w{display:flex;align-items:center;justify-content:space-between}
.logo{display:inline-flex;align-items:center;gap:9px;font:400 24px/1 var(--display);letter-spacing:-.02em;text-decoration:none}
.logo svg{width:28px;height:20px}
/* Hero */
.hero{position:relative;padding:92px 0 56px;overflow:hidden}
.hero::before{content:'';position:absolute;left:50%;top:150px;width:520px;height:520px;margin-left:-260px;background:radial-gradient(closest-side,rgba(255,92,147,.10),transparent);pointer-events:none}
.hero .w{position:relative;display:grid;gap:28px}
.hero h1{max-width:11.5em}
.hero .lead{margin-top:16px}
.stage{position:relative;width:min(300px,74vw);aspect-ratio:1/1.22;margin:4px auto 0;touch-action:none;cursor:pointer;-webkit-user-select:none;user-select:none}
.stage svg.rose{width:100%;height:100%;overflow:visible}
.stage .hint{position:absolute;left:50%;bottom:-6px;transform:translateX(-50%);white-space:nowrap;font:600 13.5px/1 var(--sans);color:var(--soft);padding:9px 14px;border-radius:99px;background:var(--glass2);border:1px solid var(--line);transition:opacity 300ms var(--ease),transform 300ms var(--ease)}
.stage.done .hint{opacity:0;transform:translate(-50%,6px)}
.stage .name{position:absolute;left:0;right:0;bottom:-18px;text-align:center;font:400 54px/1 var(--script);color:var(--rose2);opacity:0;transform:translateY(8px);transition:opacity 500ms var(--ease),transform 600ms var(--ease);pointer-events:none}
.stage.done .name{opacity:1;transform:none}
#fx{position:fixed;inset:0;pointer-events:none;z-index:60}
.cta-row{margin-top:26px}
.cta-row .btn{width:100%;max-width:420px}
/* Secciones */
section{padding:64px 0}
.sh{display:grid;gap:12px;margin-bottom:28px}
.sh .lead{font-size:17px}
/* Bento */
.bento{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.card{position:relative;padding:18px;border-radius:24px;background:var(--glass);border:1px solid var(--line);box-shadow:var(--sh1);overflow:hidden}
.card h3{margin-bottom:4px}
.card p.s{font-size:14.5px;color:var(--soft);line-height:1.5}
.card.span2{grid-column:span 2}
.demo{display:inline-block;margin-bottom:10px;font:700 11px/1 var(--sans);letter-spacing:.15em;text-transform:uppercase;color:var(--mute)}
/* Voz */
.voice{display:flex;align-items:center;gap:14px;margin-top:16px}
.play{flex:none;width:56px;height:56px;border-radius:50%;background:var(--rose);display:grid;place-items:center;transition:transform 160ms var(--ease);box-shadow:0 10px 22px -10px rgba(0,0,0,.55)}
.play:active{transform:scale(.95)}
.play svg{width:22px;height:22px;fill:#2A0A1B}
.play .pa{display:none}.play.on .pl{display:none}.play.on .pa{display:block}
.wave{flex:1;display:flex;align-items:center;gap:3px;height:48px}
.wave i{flex:1;max-width:5px;min-height:5px;height:var(--h,14px);border-radius:3px;background:var(--rose2);opacity:.7;transform-origin:center;transition:opacity 200ms}
.wave.on i{animation:bar 900ms var(--ease) infinite alternate;animation-delay:calc(var(--i)*-60ms);opacity:1}
@keyframes bar{from{transform:scaleY(.35)}to{transform:scaleY(1.9)}}
.cap{margin-top:12px;min-height:46px;font:400 17px/1.35 var(--display);color:var(--text)}
.cap span{display:block;opacity:0;transform:translateY(6px);transition:opacity 280ms var(--ease),transform 280ms var(--ease)}
.cap span.on{opacity:1;transform:none}
/* Rascar */
.scr{position:relative;margin-top:12px;height:112px;border-radius:16px;overflow:hidden;background:#FFF3F7;color:#3A1626;display:grid;place-items:center;text-align:center;padding:10px}
.scr b{font:400 26px/1.05 var(--display)}
.scr small{display:block;font:500 12px/1.3 var(--sans);color:#8A5368;margin-top:4px}
.scr canvas{position:absolute;inset:0;width:100%;height:100%;touch-action:none;transition:opacity 500ms var(--ease)}
.scr canvas.off{opacity:0;pointer-events:none}
/* Velas */
.cndls{display:flex;justify-content:center;gap:12px;margin-top:10px;height:96px;align-items:flex-end}
.c{position:relative;width:46px;height:96px;display:flex;justify-content:center}
.c .w1{position:absolute;bottom:0;width:13px;height:50px;border-radius:4px;background:repeating-linear-gradient(135deg,#FFF3F7 0 6px,var(--rose2) 6px 12px)}
.c .fl{position:absolute;bottom:54px;width:15px;height:26px;border-radius:50% 50% 50% 50%/60% 60% 40% 40%;background:radial-gradient(circle at 50% 75%,#fff 0 18%,#FFE08A 32%,#FF9A3C 66%,rgba(255,120,40,0) 72%);transform-origin:50% 90%;animation:fk 120ms ease-in-out infinite alternate;filter:drop-shadow(0 0 4px rgba(255,190,90,.6));transition:transform 220ms var(--ease),opacity 220ms var(--ease)}
.c.out .fl{transform:scale(.3);opacity:0;animation:none}
.c .sm{position:absolute;bottom:60px;width:9px;height:34px;border-radius:99px;background:radial-gradient(rgba(255,255,255,.35),transparent 70%);filter:blur(3px);opacity:0}
.c.out .sm{animation:smk 1.4s var(--ease) forwards}
@keyframes fk{from{transform:rotate(-3deg)}to{transform:rotate(3deg) scaleY(1.08)}}
@keyframes smk{0%{opacity:.8}100%{opacity:0;transform:translateY(-36px) scaleX(2.2)}}
.wish{min-height:20px;margin-top:8px;text-align:center;font:600 14px/1.3 var(--sans);color:var(--gold);opacity:0;transform:translateY(4px);transition:opacity 260ms var(--ease),transform 260ms var(--ease)}
.wish.on{opacity:1;transform:none}
/* Carta */
.paper{margin-top:14px;padding:18px 18px 16px;border-radius:16px;background:#FFF3F7;color:#3A1626}
.paper .hi{font:400 34px/1 var(--script);color:#C7336E}
.paper p{margin-top:8px;font:400 15.5px/1.55 var(--sans);color:#4A2535;max-width:34em;min-height:3.1em}
.paper .sig{margin-top:8px;font:400 24px/1 var(--script);color:#C7336E}
/* Pasos */
.steps{display:grid;gap:12px;counter-reset:s}
.step{display:grid;grid-template-columns:48px 1fr;gap:14px;align-items:start;padding:18px;border-radius:24px;background:var(--glass);border:1px solid var(--line)}
.step::before{counter-increment:s;content:counter(s);display:grid;place-items:center;width:48px;height:48px;border-radius:16px;background:var(--glass2);border:1px solid var(--line);font:400 24px/1 var(--display);color:var(--gold)}
.step h3{margin-bottom:4px}
.step p{font-size:15.5px;color:var(--soft);line-height:1.5}
/* Crear */
.make{display:grid;gap:24px}
.form{display:grid;gap:16px}
label,.lbl{display:block;font:600 14px/1.2 var(--sans);color:var(--text);margin-bottom:8px}
.lbl small,label small{font-weight:500;color:var(--mute)}
.inp{width:100%;min-height:54px;padding:0 16px;border-radius:16px;background:var(--glass);border:1px solid var(--line);color:var(--text);font-size:17px;transition:border-color 200ms ease,box-shadow 200ms ease,background-color 200ms ease}
textarea.inp{min-height:132px;padding:14px 16px;resize:vertical;line-height:1.5}
.inp::placeholder{color:var(--mute)}
.inp:focus{outline:0;border-color:var(--rose);box-shadow:0 0 0 4px rgba(255,92,147,.18);background:var(--glass2)}
.cnt{display:flex;justify-content:space-between;margin-top:6px;font-size:12.5px;color:var(--mute)}
.err{margin-top:6px;font-size:13.5px;color:#FFB3C9;min-height:0;display:none}
.err.on{display:block}
.drop{display:grid;gap:10px;padding:14px;border-radius:16px;background:var(--glass);border:1px dashed rgba(255,255,255,.18)}
.drop .row{display:flex;gap:8px;flex-wrap:wrap}
.drop .btn{min-height:46px;padding:0 16px;font-size:15px;box-shadow:none}
.drop input[type=file]{position:absolute;width:1px;height:1px;opacity:0;pointer-events:none}
.aud{display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:14px;background:var(--glass2);font-size:14px;color:var(--soft)}
.aud b{color:var(--text);font-weight:600;word-break:break-all}
.aud .play{width:40px;height:40px;box-shadow:none}
.aud .play svg{width:16px;height:16px}
.rec .dot{width:10px;height:10px;border-radius:50%;background:#FF4D6D;animation:pulse 1s ease-in-out infinite}
@keyframes pulse{50%{opacity:.35}}
/* Teléfono vista previa */
.phoneW{display:grid;place-items:center}
.phone{position:relative;width:min(300px,82vw);aspect-ratio:9/17;border-radius:38px;padding:10px;background:#0F0512;border:1px solid rgba(255,255,255,.12);box-shadow:var(--sh2)}
.screen{position:relative;height:100%;border-radius:30px;overflow:hidden;background:var(--ink2);display:flex;flex-direction:column;align-items:center;padding:34px 20px 20px;text-align:center}
.screen::before{content:'';position:absolute;top:10px;left:50%;width:72px;height:6px;margin-left:-36px;border-radius:99px;background:rgba(255,255,255,.1)}
.screen .for{margin-top:14px;font:400 15px/1.2 var(--sans);color:var(--soft)}
.screen .who{font:400 46px/1.05 var(--script);color:var(--rose2);min-height:1.1em;max-width:100%;overflow-wrap:anywhere;transition:opacity 200ms ease}
.screen .rs{width:96px;margin-top:6px}
.screen .msg{margin-top:12px;font:400 14px/1.5 var(--sans);color:var(--text);max-height:7.6em;overflow:hidden;position:relative}
.screen .msg::after{content:'';position:absolute;left:0;right:0;bottom:0;height:24px;background:linear-gradient(transparent,var(--ink2))}
.screen .pill{margin-top:auto;width:100%;display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:99px;background:var(--glass2);border:1px solid var(--line);font-size:12.5px;color:var(--soft)}
.screen .pill .play{width:34px;height:34px;box-shadow:none}
.screen .pill .play svg{width:14px;height:14px}
.screen .pill .wave{height:26px}
.screen .pill .wave i{min-height:4px}
.prev-note{margin-top:12px;font-size:13px;color:var(--mute);text-align:center}
/* Precio */
.price{padding:22px;border-radius:24px;background:var(--glass);border:1px solid rgba(245,207,114,.3);box-shadow:var(--sh1)}
.price .big{display:flex;align-items:baseline;gap:10px;margin:12px 0 4px}
.price .big b{font:400 60px/1 var(--display);letter-spacing:-.03em;color:var(--gold);font-variant-numeric:tabular-nums}
.price .big span{color:var(--soft);font-size:16px}
.price ul{list-style:none;display:grid;gap:10px;margin:16px 0 20px}
.price li{display:grid;grid-template-columns:22px 1fr;gap:10px;font-size:15.5px;line-height:1.45;color:var(--text)}
.price li svg{width:20px;height:20px;stroke:var(--gold);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;margin-top:2px}
.price .btn{width:100%}
.lock{display:flex;gap:8px;align-items:center;justify-content:center;margin-top:12px;font-size:13px;color:var(--mute)}
.lock svg{width:15px;height:15px;stroke:var(--mute);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
/* FAQ */
.faq{border-top:1px solid var(--line)}
.q{border-bottom:1px solid var(--line)}
.q button{display:flex;justify-content:space-between;align-items:center;gap:16px;width:100%;min-height:60px;padding:14px 0;text-align:left;font:600 17px/1.35 var(--sans)}
.q button svg{flex:none;width:20px;height:20px;stroke:var(--text);fill:none;stroke-width:1.8;stroke-linecap:round;transition:transform 240ms var(--ease)}
.q.open button svg{transform:rotate(45deg)}
.q .a{display:grid;grid-template-rows:0fr;transition:grid-template-rows 260ms var(--ease)}
.q.open .a{grid-template-rows:1fr}
.q .a>div{overflow:hidden}
.q .a p{padding:0 0 18px;color:var(--soft);font-size:16px;max-width:40em}
/* Cierre */
.end{text-align:center}
.end h2{max-width:11em;margin:0 auto}
.end .lead{margin:14px auto 0}
.end .btn{margin-top:26px;width:100%;max-width:420px}
footer{padding:28px 0 calc(110px + env(safe-area-inset-bottom));border-top:1px solid var(--line);color:var(--mute);font-size:13.5px}
footer .w{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
/* Barra fija */
.sk{position:fixed;left:0;right:0;bottom:0;z-index:30;display:flex;align-items:center;gap:12px;padding:10px 14px calc(10px + env(safe-area-inset-bottom));background:rgba(28,10,32,.92);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-top:1px solid var(--line);transform:translateY(110%);transition:transform 260ms var(--ease)}
.sk.show{transform:none}
.sk .t{flex:1;min-width:0;line-height:1.2}
.sk .t b{display:block;font:400 18px/1.1 var(--display)}
.sk .t span{font-size:12.5px;color:var(--mute)}
.sk .btn{min-height:50px;padding:0 22px;font-size:16px;box-shadow:none}
/* Toast */
.toast{position:fixed;left:50%;width:max-content;bottom:calc(92px + env(safe-area-inset-bottom));z-index:70;max-width:calc(100vw - 32px);text-align:center;padding:12px 18px;border-radius:16px;background:var(--gold);color:#2A1A06;font:600 14.5px/1.35 var(--sans);box-shadow:var(--sh2);transform:translate(-50%,16px);opacity:0;pointer-events:none;transition:transform 260ms var(--ease),opacity 220ms ease}
.toast.on{transform:translate(-50%,0);opacity:1}
/* Entradas */
.js .rv{opacity:0;transform:translateY(10px);transition:opacity 280ms var(--ease),transform 280ms var(--ease);transition-delay:calc(var(--i,0)*50ms)}
.js .rv.in{opacity:1;transform:none}
/* Escritorio */
@media (min-width:900px){
  body{font-size:18px}
  .hero{padding:120px 0 84px}
  .hero .w{grid-template-columns:1.05fr .95fr;align-items:center;gap:56px}
  .stage{width:360px;margin:0 auto}
  .bento{grid-template-columns:repeat(6,1fr)}
  .card.span2{grid-column:span 4}.card:not(.span2){grid-column:span 2}
  .steps{grid-template-columns:repeat(3,1fr)}
  .step{grid-template-columns:1fr;gap:12px}
  .make{grid-template-columns:1fr 360px;gap:48px;align-items:start}
  .make .col2{display:grid;gap:20px;position:sticky;top:24px}
  .sk{display:none}
}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:1ms!important;animation-iteration-count:1!important;transition-duration:1ms!important;transition-delay:0ms!important;scroll-behavior:auto!important}
  .js .rv{opacity:1;transform:none}
}

/* ===== v2 · fotos y emoción ===== */
.eyebrow{font:700 12px/1 var(--sans);letter-spacing:.15em;text-transform:uppercase;color:var(--gold);margin-bottom:14px}
.hero{padding:0;min-height:100svh;display:flex;align-items:flex-end;isolation:isolate}
.hero::before{display:none}
.hbg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:42% 30%;z-index:-2}
.hero::after{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(to top,rgba(26,13,14,.96) 0%,rgba(26,13,14,.82) 38%,rgba(26,13,14,.25) 72%,rgba(26,13,14,.1) 100%)}
.hero .w{display:block;padding-top:110px;padding-bottom:44px}
.hero h1{max-width:12em;font-size:clamp(38px,10.6vw,72px)}
.hero .lead{color:#E8D6D2}
.story{padding-top:72px}
.story .w{display:grid;gap:28px;align-items:center}
.sfig img,.vfig img{width:100%;height:auto;border-radius:24px;box-shadow:var(--sh2)}
.sfig,.vfig{margin:0}
.stx{display:grid;gap:14px}
.vfig{max-width:520px;margin:0 auto 28px}
.vfig img{aspect-ratio:4/3;object-fit:cover}
.rosa{padding-top:24px}
.rosa .stage{margin-top:8px}
.end{position:relative;overflow:hidden;isolation:isolate}
.ebg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 25%;z-index:-2;opacity:.5}
.end::after{content:'';position:absolute;inset:0;z-index:-1;background:rgba(26,13,14,.62)}
@media (min-width:900px){
  .hero .w{padding-bottom:84px}
  .hero::after{background:linear-gradient(to right,rgba(26,13,14,.94) 0%,rgba(26,13,14,.78) 42%,rgba(26,13,14,.1) 80%)}
  .hbg{object-position:70% 25%}
  .story .w{grid-template-columns:1.15fr 1fr;gap:56px}
  .vfig{float:none}
}

/* ===== v3 · estructura de venta ===== */
.how{padding-top:56px;padding-bottom:24px}
.how .steps{gap:10px}
.price .anchor{margin:-4px 0 14px;font-size:14.5px;color:var(--soft)}
/* ===== v4 · regalo, soplido y minuto a minuto ===== */
[hidden]{display:none!important}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:10px}
.chip{min-height:44px;padding:0 16px;border-radius:99px;background:var(--glass2);border:1px solid var(--line);font:600 15px/1 var(--sans);color:var(--soft);transition:transform 160ms var(--ease),background-color 200ms ease,color 200ms ease}
.chip:active{transform:scale(.97)}
.chip.on{background:var(--rose);color:#2A0A1B;border-color:transparent}
.blow{margin:10px auto 0;display:flex}
.mom{padding-top:24px}
.tl{list-style:none;display:grid;gap:0;max-width:680px}
.tl li{display:grid;grid-template-columns:64px 1fr;gap:16px;padding:18px 0}
.tl time{font:400 26px/1.1 var(--display);color:var(--gold);font-variant-numeric:tabular-nums}
.tl h3{margin-bottom:4px}
.tl p{color:var(--soft);font-size:16px}

/* ===== v7 · movimiento con intención ===== */
@media (prefers-reduced-motion:no-preference){
  .js .hbg{animation:settle 1400ms var(--ease) both}
  @keyframes settle{from{transform:scale(1.07)}to{transform:scale(1)}}
}
.btn[disabled]{opacity:.75}
/* ===== v5 · 20 minutos ===== */
.mins{background:var(--rose);color:#2A0A1B;padding:72px 0}
.mins .w{display:grid;gap:20px;align-items:end}
.big20{font:400 clamp(160px,52vw,320px)/.78 var(--display);letter-spacing:-.06em;color:#2A0A1B}
.big20 span{font-size:.24em;letter-spacing:-.02em;margin-left:.12em}
.mins h2{color:#2A0A1B;max-width:15em}
.mins p{margin-top:14px;font-size:18px;color:#3F1229;max-width:30em}
@media (min-width:900px){.mins .w{grid-template-columns:auto 1fr;gap:64px;align-items:center}.mins{padding:96px 0}}

/* ===== v6 · mosaico de personas ===== */
.mosaic{display:grid;gap:12px;grid-template-columns:1fr 1fr}
.m{position:relative;margin:0;border-radius:24px;overflow:hidden;aspect-ratio:1/1.1;background:var(--ink2)}
.m.big,.m.wide{grid-column:1/-1;aspect-ratio:3/2}
.m img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.m::after{content:'';position:absolute;inset:0;background:linear-gradient(to top,rgba(26,13,14,.88) 0%,rgba(26,13,14,.4) 45%,rgba(26,13,14,0) 75%)}
.m figcaption{position:absolute;left:0;right:0;bottom:0;z-index:1;padding:16px}
.m h3{font-size:20px;color:#fff}
.m p{margin-top:4px;font-size:14.5px;line-height:1.4;color:#EBDCD8}
@media (min-width:900px){.mosaic{grid-template-columns:repeat(6,1fr);gap:16px}.m{grid-column:span 2;aspect-ratio:4/5}.m.big{grid-column:span 4;aspect-ratio:auto;min-height:480px}.m.wide{grid-column:span 4;aspect-ratio:auto;min-height:480px}.m h3{font-size:26px}.m p{font-size:16px}.m figcaption{padding:24px}}
</style>
</head>
<body>
<canvas id="fx" aria-hidden="true"></canvas>

<header class="nav"><div class="w">
  <a class="logo" href="#top" aria-label="Latido"><svg viewBox="0 0 28 20" fill="none" stroke="#FF5C93" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 11h5l3-8 5 15 3-9 2 2h8"/></svg>Latido</a>
  <a class="btn sm ghost" href="#crear">Crear la mía</a>
</div></header>

<main id="top">
<!-- Hero -->
<section class="hero">
  <img class="hbg" src="{% endraw %}{{ 'lt-pareja.webp' | file_url }}{% raw %}" width="1500" height="1000" alt="Una pareja en un balcón: ella le acerca el celular al oído y él se tapa la boca, conmovido, mientras ella ríe entre lágrimas" fetchpriority="high">
  <div class="w"><div class="ht">
    <h1 class="rv">Hay cosas que alguien lleva años esperando oírte decir.</h1>
    <p class="lead rv" style="--i:2">Dilas con tu voz. Nosotros las convertimos en una sorpresa para su celular: una rosa que florece, velas que se soplan, un regalo escondido y una carta con su nombre.</p>
    <div class="cta-row rv" style="--i:3">
      <a class="btn" href="#crear" id="heroCta">Quiero sorprenderla · $15 USD</a>
      <p class="micro">Un solo pago · Lista en 20 minutos · Para toda Latinoamérica</p>
    </div>
  </div></div>
</section>

<!-- 20 minutos -->
<section class="mins"><div class="w">
  <div class="big20 rv" aria-hidden="true">20<span>min</span></div>
  <div class="mt">
    <h2 class="rv">Pagas, nos mandas tu audio, y en 20 minutos su sorpresa está lista.</h2>
    <p class="rv" style="--i:1">Sin esperar días ni quedarte con la duda de si llega a tiempo. Si el cumpleaños es hoy, todavía llegas.</p>
  </div>
</div></section>

<!-- Pasos -->
<section class="how"><div class="w">
  <div class="sh"><h2 class="rv">Tres pasos y ya está.</h2></div>
  <div class="steps">
    <div class="step rv"><div><h3>Dile lo que nunca le has dicho</h3><p>Escribe su nombre y tu mensaje. Graba tu voz o sube una nota que ya tengas. No tiene que quedar perfecto, tiene que sonar a ti.</p></div></div>
    <div class="step rv" style="--i:1"><div><h3>Nosotros armamos la sorpresa</h3><p>Pagas $15 USD una sola vez. Ponemos su nombre, tu voz y tus palabras dentro de algo hecho solo para esa persona.</p></div></div>
    <div class="step rv" style="--i:2"><div><h3>Le pasas la tarjeta y esperas su audio</h3><p>En 20 minutos te enviamos por WhatsApp una tarjeta bonita con un QR en forma de corazón. Se la das, impresa o por chat. Escanea, y empieza todo.</p></div></div>
  </div>
</div></section>

<!-- Historia -->
<section class="story"><div class="w">
  <figure class="sfig rv"><img src="{% endraw %}{{ 'lt-noche.webp' | file_url }}{% raw %}" width="1000" height="1000" loading="lazy" alt="Una mujer sentada en el piso de su cuarto llora y sonríe mientras escucha una nota de voz, con un pedazo de torta a su lado"></figure>
  <div class="stx">
    <h2 class="rv">Un ramo se marchita. Tu voz se queda.</h2>
    <p class="lead rv" style="--i:1">Piensa en un audio que tengas guardado de alguien que quieres. Lo has escuchado más veces de las que admitirías.</p>
    <p class="lead rv" style="--i:2">Ahora imagina ser tú esa voz. La que busca cuando te extraña. Eso no lo da ninguna tienda, y empieza con un minuto tuyo.</p>
  </div>
</div></section>

<!-- Minuto a minuto -->
<section class="mom"><div class="w">
  <div class="sh"><h2 class="rv">Lo que va a sentir, minuto a minuto.</h2><p class="lead rv" style="--i:1">Tú sabes cómo se pone cuando algo le llega al corazón.</p></div>
  <ol class="tl">
    <li class="rv"><time>0:00</time><div><h3>Escanea el corazón</h3><p>Abre la tarjeta que le diste. Todavía no sabe qué es.</p></div></li>
    <li class="rv" style="--i:1"><time>0:10</time><div><h3>La rosa se abre despacio</h3><p>Y aparece su nombre, escrito solo para esa persona.</p></div></li>
    <li class="rv" style="--i:2"><time>0:25</time><div><h3>Escucha tu voz</h3><p>Se queda en silencio. Lo que le dices ya no es un texto, eres tú.</p></div></li>
    <li class="rv" style="--i:3"><time>1:30</time><div><h3>Raspa y encuentra su regalo</h3><p>Dinero, un plan o lo que hayas escondido. Aquí empieza la risa.</p></div></li>
    <li class="rv" style="--i:4"><time>2:00</time><div><h3>Sopla las velas y pide un deseo</h3><p>Sopla de verdad, y las llamas se apagan una por una.</p></div></li>
    <li class="rv" style="--i:5"><time>2:30</time><div><h3>Lee tu carta, y te escribe</h3><p>Es lo último que ve. Prepárate, porque te va a contestar.</p></div></li>
  </ol>
</div></section>

<!-- La rosa -->
<section class="rosa"><div class="w">
  <div class="sh" style="text-align:center;justify-items:center"><h2 class="rv">Así empieza: una rosa que se abre con el dedo.</h2><p class="lead rv" style="--i:1">Es lo primero que se ve al abrirla. Mantenla presionada.</p></div>
  <div class="stage rv" id="stage" style="--i:2" role="button" tabindex="0" aria-label="Mantén presionada la rosa para abrirla">
    <svg class="rose" id="roseSvg" viewBox="-120 -130 240 300" aria-hidden="true"></svg>
    <div class="name" id="stageName" aria-hidden="true">Para ti</div>
    <div class="hint" id="stageHint">Mantén presionada la rosa</div>
  </div>
</div></section>

<!-- Así se siente -->
<section><div class="w">
  <div class="sh"><h2 class="rv">Esto es lo que se vive, momento a momento.</h2><p class="lead rv" style="--i:1">Pruébalo tú. Así lo siente quien la recibe.</p></div>
  <div class="bento">
    <article class="card span2 rv">
      <span class="demo">Demo</span>
      <h3>Tu voz, tal cual la grabaste</h3>
      <p class="s">Tu audio suena en la sorpresa y tus palabras aparecen en pantalla mientras hablas.</p>
      <div class="voice"><button class="play" id="vPlay" type="button" aria-label="Ver la demo de voz"><svg class="pl" viewBox="0 0 24 24"><path d="M8 5.5v13l10.5-6.5z"/></svg><svg class="pa" viewBox="0 0 24 24"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"/></svg></button><div class="wave" id="vWave" aria-hidden="true"></div></div>
      <div class="cap" id="vCap" aria-live="polite"><span class="on">Toca play para ver cómo se lee tu voz.</span></div>
    </article>
    <article class="card rv" style="--i:1">
      <span class="demo">Demo</span>
      <h3>Su regalo escondido</h3>
      <p class="s">Se raspa con el dedo y descubre qué le regalas: dinero, un plan o lo que tú quieras.</p>
      <div class="scr" id="scr"><div><b id="gB">Te quiero muchísimo</b><small id="gS">Lo que escondiste aquí</small></div><canvas id="scrC" aria-label="Raspa con el dedo para descubrir el mensaje"></canvas></div>
    </article>
    <article class="card rv" style="--i:2">
      <span class="demo">Demo</span>
      <h3>Las velas</h3>
      <p class="s">Se apagan soplando de verdad, como en una torta. Prueba tú.</p>
      <div class="cndls" id="cndls"><button class="c" type="button" aria-label="Apagar vela 1"><i class="w1"></i><i class="fl"></i><i class="sm"></i></button><button class="c" type="button" aria-label="Apagar vela 2"><i class="w1"></i><i class="fl"></i><i class="sm"></i></button><button class="c" type="button" aria-label="Apagar vela 3"><i class="w1"></i><i class="fl"></i><i class="sm"></i></button></div>
      <div class="wish" id="wish" aria-live="polite">Pide un deseo</div>
      <button class="btn ghost sm blow" id="blow" type="button">Sopla de verdad</button>
    </article>
    <article class="card span2 rv">
      <span class="demo">Se arma con lo que tú escribas</span>
      <h3>Una carta con tus palabras</h3>
      <p class="s">Escribe abajo, en “Crea la tuya”, y mira cómo se llena esta carta.</p>
      <div class="paper"><div class="hi" id="pHi">Para Alex,</div><p id="pMsg">Gracias por ser la persona que eres. Hoy quería decirte, con mi voz y con estas palabras, cuánto te quiero.</p><div class="sig" id="pSig">Con cariño</div></div>
    </article>
  </div>
</div></section>

<!-- Para quién -->
<section class="who"><div class="w">
  <div class="sh"><h2 class="rv">Para quien sea. Mamá, papá, tu pareja, tu mejor amigo.</h2><p class="lead rv" style="--i:1">Hombres y mujeres, jóvenes y viejos. Funciona igual a tres cuadras o a tres mil kilómetros, en cualquier país de Latinoamérica.</p></div>
  <div class="mosaic">
    <figure class="m big rv"><img src="{% endraw %}{{ 'lt-abuela.webp' | file_url }}{% raw %}" width="1500" height="1000" loading="lazy" alt="Una abuela llora de emoción al escuchar un mensaje de voz por teléfono, frente a una torta con una vela"><figcaption><h3>Tu mamá o tu papá</h3><p>Llevan toda la vida cuidándote. Que oigan, por fin, cuánto lo sabes.</p></figcaption></figure>
    <figure class="m rv" style="--i:1"><img src="{% endraw %}{{ 'lt-hombre.webp' | file_url }}{% raw %}" width="900" height="900" loading="lazy" alt="Un hombre con audífonos llora y sonríe al escuchar un audio en su cuarto, con una vela de cumpleaños"><figcaption><h3>Tu pareja</h3><p>Más que un "te amo" por chat. Algo que se abre, se escucha y se guarda.</p></figcaption></figure>
    <figure class="m rv" style="--i:2"><img src="{% endraw %}{{ 'lt-amigas.webp' | file_url }}{% raw %}" width="900" height="900" loading="lazy" alt="Dos amigas en una terraza, una llora de risa mientras escucha un audio en el celular"><figcaption><h3>Tu mejor amiga o amigo</h3><p>El que te aguanta todo. Dile lo que vale para ti.</p></figcaption></figure>
    <figure class="m wide rv" style="--i:3"><img src="{% endraw %}{{ 'lt-papa.webp' | file_url }}{% raw %}" width="900" height="900" loading="lazy" alt="Un señor de bigote gris escucha el audio de su hija en el celular, con los ojos rojos y orgulloso"><figcaption><h3>Tu familia, cerca o lejos</h3><p>Si los separa un país, esto llega en un segundo y se siente como estar ahí.</p></figcaption></figure>
  </div>
</div></section>

<!-- Crear -->
<section id="crear"><div class="w">
  <div class="sh"><h2 class="rv">Crea la suya.</h2><p class="lead rv" style="--i:1">Escribe su nombre y tu mensaje. Aquí ves cómo se va a ver en su celular.</p></div>
  <div class="make">
    <form class="form rv" id="form" novalidate>
      <div><label for="fTo">¿Para quién es?</label><input class="inp" id="fTo" name="to" maxlength="24" autocomplete="off" placeholder="Alex" aria-describedby="eTo"><p class="err" id="eTo" role="alert">Escribe el nombre de quien cumple años.</p></div>
      <div><label for="fFrom">¿De parte de quién? <small>(opcional)</small></label><input class="inp" id="fFrom" name="from" maxlength="30" autocomplete="given-name" placeholder="Tu nombre"></div>
      <div><label for="fMsg">Tu mensaje</label><textarea class="inp" id="fMsg" name="msg" maxlength="400" placeholder="Escribe como si estuviera enfrente. Un recuerdo, un gracias, lo que no le has dicho." aria-describedby="eMsg"></textarea><div class="cnt"><span>Lo que escribas aparece en su carta.</span><span id="fCnt">0/400</span></div><p class="err" id="eMsg" role="alert">Cuéntale un poquito más (mínimo 10 letras).</p></div>
      <div><span class="lbl" id="gLbl">¿Qué le vas a regalar? <small>(opcional)</small></span>
        <div class="chips" id="gChips" role="group" aria-labelledby="gLbl">
          <button type="button" class="chip" data-g="money" aria-pressed="false">Dinero</button>
          <button type="button" class="chip" data-g="plan" aria-pressed="false">Un plan</button>
          <button type="button" class="chip" data-g="gift" aria-pressed="false">Un regalo</button>
          <button type="button" class="chip on" data-g="love" aria-pressed="true">Solo mi cariño</button>
        </div>
        <input class="inp" id="fGift" maxlength="40" autocomplete="off" hidden aria-label="Qué le vas a regalar">
        <p class="micro" id="gNote" hidden style="margin-top:8px">Lo descubre raspando la tarjeta. El regalo se lo das tú; nosotros solo lo escondemos en la sorpresa.</p>
      </div>
      <div><span class="lbl">Tu audio <small>(opcional, pero es lo que más emociona)</small></span>
        <div class="drop">
          <div class="row"><button class="btn ghost" id="recBtn" type="button"><span class="dot" hidden></span><span id="recT">Grabar ahora</span></button><label class="btn ghost" for="fFile" style="margin:0;cursor:pointer">Subir un audio</label><input id="fFile" type="file" accept="audio/*"></div>
          <div class="aud" id="aud" hidden><button class="play" id="aPlay" type="button" aria-label="Escuchar tu audio"><svg class="pl" viewBox="0 0 24 24"><path d="M8 5.5v13l10.5-6.5z"/></svg><svg class="pa" viewBox="0 0 24 24"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"/></svg></button><span><b id="aName">Tu audio</b><br><span id="aInfo"></span></span></div>
          <p class="micro" style="margin:0" id="audNote">Después del pago, te mostramos cómo enviarnos el audio por WhatsApp en un toque.</p>
          <p class="err" id="eAud" role="alert"></p>
        </div>
      </div>
    </form>
    <div class="col2">
      <div class="phoneW rv" style="--i:1"><div>
        <div class="phone"><div class="screen">
          <div class="for">Alguien te dejó algo</div>
          <div class="who" id="sWho">Valentina</div>
          <svg class="rs" id="sRose" viewBox="-120 -130 240 300" aria-hidden="true"></svg>
          <div class="msg" id="sMsg">Gracias por ser la persona que eres. Hoy quería decirte, con mi voz y con estas palabras, cuánto te quiero.</div>
          <div class="pill"><button class="play" id="sPlay" type="button" aria-label="Escuchar el audio" disabled><svg class="pl" viewBox="0 0 24 24"><path d="M8 5.5v13l10.5-6.5z"/></svg><svg class="pa" viewBox="0 0 24 24"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"/></svg></button><div class="wave" id="sWave" aria-hidden="true"></div><span id="sTag">Tu audio</span></div>
        </div></div>
        <p class="prev-note">Vista previa. La sorpresa completa trae mucho más.</p>
      </div></div>
      <div class="price rv" style="--i:2">
        <span class="tag">Precio de lanzamiento</span>
        <div class="big"><b>$15</b><span>USD · pago único</span></div>
        <p class="anchor">Un ramo cuesta más y dura una semana. Esto lo escucha cuando quiera.</p>
        <ul>
          <li><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7"/></svg>Tu voz y tu mensaje dentro de una sorpresa para su celular</li>
          <li><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7"/></svg>Rosa que se abre, velas que se soplan, regalo escondido y carta con su nombre</li>
          <li><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7"/></svg>Ajustes si algo no quedó como querías</li>
          <li><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7"/></svg>Tarjeta bonita con QR en corazón, enviada a tu WhatsApp</li>
          <li><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7"/></svg>Lista en 20 minutos</li>
        </ul>
        <button class="btn" id="payBtn" type="button">Pagar $15 USD</button>
        <div class="lock"><svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>Pago con tarjeta, procesado por Stripe</div>
      </div>
    </div>
  </div>
</div></section>

<!-- Preguntas -->
<section><div class="w">
  <div class="sh"><h2 class="rv">Lo que casi todos preguntan</h2></div>
  <div class="faq rv" id="faq">
    <div class="q"><button type="button" aria-expanded="false">¿Cómo le llega el dinero o el regalo?<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button><div class="a"><div><p>Se lo das tú, como prefieras: transferencia, Nequi, Yape, Mercado Pago o en persona. En la sorpresa escribimos lo que le regalas, y se descubre raspando la tarjeta. Es el momento de contárselo.</p></div></div></div>
    <div class="q"><button type="button" aria-expanded="false">¿Y si me da vergüenza grabar?<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button><div class="a"><div><p>A casi todos les da. Grábalo como si le escribieras un audio por WhatsApp. Lo que emociona no es una voz perfecta, es que sea la tuya. Y puedes repetirlo las veces que quieras antes de enviarlo.</p></div></div></div>
    <div class="q"><button type="button" aria-expanded="false">¿Funciona si vive en otro país?<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button><div class="a"><div><p>Sí. Es un link: se abre en cualquier celular con internet, en cualquier país de Latinoamérica o del mundo. Tú pagas en dólares, la otra persona no paga nada.</p></div></div></div>
    <div class="q"><button type="button" aria-expanded="false">¿Cómo la recibe la persona?<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button><div class="a"><div><p>Tú recibes por WhatsApp una tarjeta bonita con un QR en forma de corazón, y se la pasas: impresa, o como imagen por chat. La otra persona la escanea con la cámara del celular y la sorpresa arranca sola. No necesita app ni cuenta.</p></div></div></div>
    <div class="q"><button type="button" aria-expanded="false">¿Cuánto me demoro en tenerla?<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button><div class="a"><div><p>Te la entregamos en 20 minutos, después de que nos mandes tu audio y tu mensaje. Si el cumpleaños es hoy, todavía llegas.</p></div></div></div>
    <div class="q"><button type="button" aria-expanded="false">¿Y si no tengo audio?<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button><div class="a"><div><p>La sorpresa funciona igual solo con tu mensaje escrito. Pero con tu voz se siente distinto, y casi siempre vale la pena grabar un minuto.</p></div></div></div>
    <div class="q"><button type="button" aria-expanded="false">¿Cómo pago?<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button><div class="a"><div><p>Con tarjeta, en una página de Stripe. Pagas $15 USD una sola vez. Nosotros nunca vemos los datos de tu tarjeta.</p></div></div></div>
    <div class="q"><button type="button" aria-expanded="false">¿Qué pasa con mi audio y mi mensaje?<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button><div class="a"><div><p>Solo los usamos para armar tu sorpresa. Quien tenga el link puede verla, así que mándaselo solo a quien quieras.</p></div></div></div>
  </div>
</div></section>

<!-- Cierre -->
<section class="end"><img class="ebg" src="{% endraw %}{{ 'lt-noche.webp' | file_url }}{% raw %}" width="1000" height="1000" loading="lazy" alt=""><div class="w">
  <h2 class="rv">Dentro de diez años no recordará qué le regalaste. Recordará lo que le dijiste.</h2>
  <p class="lead rv" style="--i:1">Todavía estás a tiempo de que sea este cumpleaños.</p>
  <a class="btn rv" style="--i:2" href="#crear">Quiero sorprenderla · $15 USD</a>
</div></section>
</main>

<footer><div class="w"><span>Latido · Hecho con cariño</span><span>Pagos procesados por Stripe</span></div></footer>

<div class="sk" id="sk" aria-hidden="true"><div class="t"><b>$15 USD</b><span>Precio de lanzamiento</span></div><a class="btn" href="#crear" tabindex="-1">Quiero sorprenderla</a></div>
<div class="toast" id="toast" role="status"></div>

<script>
(()=>{
'use strict';
/* ====== CONFIGURACIÓN (lo único que hay que tocar para publicar) ====== */
const CONFIG={
  variantId:'68129771094229',                  // Shopify: id de la variante del producto (lo pone el armado)
  stripeLink:'',                 // Payment Link de Stripe, por ejemplo https://buy.stripe.com/xxxx
  whatsapp:'573217493251',       // WhatsApp que recibe los audios (con 57, sin +)
  thanksUrl:'/pages/latido-gracias'
};
