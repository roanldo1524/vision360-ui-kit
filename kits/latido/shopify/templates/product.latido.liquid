/* audio: subir o grabar, con vista previa */
const au=new Audio();let playing=false;
const setPlay=on=>{playing=on;['#aPlay','#sPlay'].forEach(s=>$(s).classList.toggle('on',on));$('#sWave').classList.toggle('on',on)};
au.addEventListener('ended',()=>setPlay(false));
function setAudio(url,name,info){st.audio=url;st.audioName=name;au.src=url;$('#aud').hidden=false;$('#aName').textContent=name;$('#aInfo').textContent=info||'';$('#sPlay').disabled=false;$('#sTag').textContent=name.length>16?name.slice(0,15)+'…':name;setPlay(false)}
function togglePlay(){if(!st.audio)return;if(playing){au.pause();setPlay(false)}else{au.play().then(()=>setPlay(true)).catch(()=>{})}}
$('#aPlay').addEventListener('click',togglePlay);$('#sPlay').addEventListener('click',togglePlay);
const aerr=m=>{const e=$('#eAud');e.textContent=m;e.classList.toggle('on',!!m)};
$('#fFile').addEventListener('change',e=>{const f=e.target.files[0];if(!f)return;aerr('');
  if(!/^audio\//.test(f.type)){aerr('Ese archivo no es un audio. Sube una nota de voz o un mp3.');return}
  if(f.size>15*1024*1024){aerr('Pesa más de 15 MB. Sube un audio más corto (un minuto es suficiente).');return}
  setAudio(URL.createObjectURL(f),f.name,(f.size/1024/1024).toFixed(1)+' MB');toast('Audio listo. Dale play y escúchalo.')});
let mr=null,chunks=[],strm=null,t0=0,rt=0;
const recBtn=$('#recBtn');
async function startRec(){aerr('');
  if(!navigator.mediaDevices||!window.MediaRecorder){aerr('Este navegador no deja grabar aquí. Usa “Subir un audio” con una nota de voz.');return}
  try{strm=await navigator.mediaDevices.getUserMedia({audio:true})}catch(e){aerr('No pudimos usar el micrófono. Revisa el permiso del navegador o sube una nota de voz.');return}
  chunks=[];mr=new MediaRecorder(strm);mr.ondataavailable=e=>e.data.size&&chunks.push(e.data);
  mr.onstop=()=>{clearInterval(rt);strm.getTracks().forEach(t=>t.stop());const blob=new Blob(chunks,{type:mr.mimeType||'audio/webm'});recBtn.classList.remove('rec');recBtn.querySelector('.dot').hidden=true;$('#recT').textContent='Grabar de nuevo';setAudio(URL.createObjectURL(blob),'Tu grabación',Math.round((Date.now()-t0)/1000)+' s')};
  mr.start();t0=Date.now();recBtn.classList.add('rec');recBtn.querySelector('.dot').hidden=false;
  rt=setInterval(()=>{const s=Math.round((Date.now()-t0)/1000);$('#recT').textContent='Detener · '+s+' s';if(s>=90)mr.state==='recording'&&mr.stop()},300)}
recBtn.addEventListener('click',()=>{if(mr&&mr.state==='recording'){mr.stop();return}startRec()});

/* pago */
function pay(){let ok=true;
  if(st.to.trim().length<2){$('#eTo').classList.add('on');ok=false;$to.focus()}
  if(st.msg.trim().length<10){$('#eMsg').classList.add('on');if(ok)$ms.focus();ok=false}
  if(!ok){document.getElementById('crear').scrollIntoView({behavior:RM?'auto':'smooth'});return}
  const id='lt'+Date.now().toString(36)+Math.random().toString(36).slice(2,6);
  try{localStorage.setItem('latido_draft',JSON.stringify({id,to:st.to.trim(),from:st.from.trim(),msg:st.msg.trim(),hasAudio:!!st.audio,audioName:st.audioName,gt:st.gt,gift:st.gift.trim(),t:Date.now()}))}catch(e){}
  if(CONFIG.variantId){
    const b=$('#payBtn'),b0=b.textContent;b.disabled=true;b.textContent='Abriendo el pago…';
    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:[{id:+CONFIG.variantId,quantity:1,properties:{'Para':st.to.trim(),'De parte de':st.from.trim(),'Mensaje':st.msg.trim(),'Regalo escondido':st.gt==='love'?'Solo cariño':({money:'Dinero',plan:'Un plan',gift:'Un regalo'})[st.gt]+(st.gift.trim()?': '+st.gift.trim():''),'Audio':st.audio?'Sí ('+(st.audioName||'grabado')+')':'Lo enviará por WhatsApp','Pedido':id}}]})})
      .then(r=>{if(!r.ok)throw 0;location.href='/checkout'}).catch(()=>{b.disabled=false;b.textContent=b0;toast('No pudimos abrir el pago. Intenta de nuevo.')});
    return}
  if(!CONFIG.stripeLink){toast('Modo de prueba: aquí se abre el pago de Stripe.');buzz(10);return}
  const u=CONFIG.stripeLink+(CONFIG.stripeLink.includes('?')?'&':'?')+'client_reference_id='+encodeURIComponent(id);
  location.href=u}
$('#payBtn').addEventListener('click',pay);
(()=>{const n=document.querySelector('.big20');if(!n||RM)return;const t=n.firstChild;const io=new IntersectionObserver(es=>{if(!es[0].isIntersecting)return;io.disconnect();
  const T=700,t0=performance.now();(function f(now){const k=Math.min(1,(now-t0)/T),e=1-Math.pow(1-k,3);t.nodeValue=Math.round(20*e);if(k<1)requestAnimationFrame(f)})(t0)},{threshold:.5});
  t.nodeValue='0';io.observe(n)})();
if(!RM)setTimeout(()=>burst(36,innerWidth/2,Math.min(innerHeight*.3,220)),900);
})();
