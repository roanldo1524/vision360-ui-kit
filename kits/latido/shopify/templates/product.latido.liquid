/* ====== Confeti y pétalos ====== */
const cv=$('#fx'),cx=cv.getContext('2d');let P=[],raf=0;
const COL=['#FF5C93','#FF8DB3','#F5CF72','#FFD4E2','#FFFFFF'];
function fit(){const r=Math.min(devicePixelRatio||1,2);cv.width=innerWidth*r;cv.height=innerHeight*r;cx.setTransform(r,0,0,r,0,0)}fit();addEventListener('resize',fit);
function burst(n,x,y){if(RM)n=Math.min(n,14);for(let i=0;i<n;i++){const a=Math.random()*Math.PI*2,s=3+Math.random()*6;P.push({x,y,vx:Math.cos(a)*s,vy:Math.sin(a)*s-4,r:Math.random()*6,vr:(Math.random()-.5)*.3,w:7+Math.random()*7,c:COL[i%COL.length],l:90+Math.random()*40,pet:i%3===0})}if(!raf)tick()}
function tick(){cx.clearRect(0,0,innerWidth,innerHeight);P=P.filter(p=>p.l-->0&&p.y<innerHeight+30);for(const p of P){p.vy+=.17;p.vx*=.985;p.x+=p.vx;p.y+=p.vy;p.r+=p.vr;cx.save();cx.translate(p.x,p.y);cx.rotate(p.r);cx.globalAlpha=Math.min(1,p.l/30);cx.fillStyle=p.c;if(p.pet){cx.beginPath();cx.ellipse(0,0,p.w*.5,p.w*.28,0,0,Math.PI*2);cx.fill()}else cx.fillRect(-p.w/2,-p.w/4,p.w,p.w/2);cx.restore()}raf=P.length?requestAnimationFrame(tick):0;if(!raf)cx.clearRect(0,0,innerWidth,innerHeight)}

/* ====== Rosa dibujada en código ====== */
const NS='http://www.w3.org/2000/svg',PET='M0 0 C-20 -8 -26 -40 -13 -56 C-6 -64 6 -64 13 -56 C26 -40 20 -8 0 0Z';let gid=0;
function makeRose(svg,size,cols,stem){
  const id='g'+(gid++);svg.insertAdjacentHTML('beforeend',`<defs><radialGradient id="${id}a" cx="50%" cy="100%" r="100%"><stop offset="0" stop-color="${cols[2]}"/><stop offset=".7" stop-color="${cols[0]}"/><stop offset="1" stop-color="${cols[1]}"/></radialGradient><radialGradient id="${id}b" cx="50%" cy="100%" r="100%"><stop offset="0" stop-color="${cols[2]}"/><stop offset="1" stop-color="${cols[0]}"/></radialGradient></defs>`);
  if(stem)svg.insertAdjacentHTML('beforeend',`<path d="M0 60 C-4 100 6 130 0 170" stroke="#4F8A63" stroke-width="5" fill="none" stroke-linecap="round"/><path d="M2 110 C30 92 58 96 72 108 C52 124 26 124 2 110Z" fill="#4F8A63"/><path d="M-1 138 C-28 120 -56 124 -70 136 C-50 152 -24 152 -1 138Z" fill="#3F7A53" opacity=".9"/>`);
  const g=document.createElementNS(NS,'g');svg.appendChild(g);
  const rings=[[8,1.25,0,`url(#${id}a)`],[7,1,25,`url(#${id}a)`],[6,.78,10,`url(#${id}b)`],[5,.56,40,`url(#${id}b)`],[4,.36,5,`url(#${id}b)`]],ps=[];
  rings.forEach(([n,sc,off,fill],r)=>{for(let i=0;i<n;i++){const p=document.createElementNS(NS,'path');p.setAttribute('d',PET);p.setAttribute('fill',fill);p.setAttribute('stroke','rgba(0,0,0,.14)');p.setAttribute('stroke-width','.8');g.appendChild(p);ps.push({p,a:off+i*360/n,sc,r})}});
  const set=b=>{b=Math.max(0,Math.min(1,b));ps.forEach(({p,a,sc,r})=>{const t=Math.max(0,Math.min(1,(b-r*.1)/.6)),e=1-Math.pow(1-t,3),s=sc*(.42+.58*e),tilt=(1-e)*(r<2?0:6);p.setAttribute('transform',`rotate(${a+(1-e)*30}) translate(0 ${-tilt}) scale(${s*(.75+.25*e)} ${s})`)});g.setAttribute('transform',`scale(${size}) rotate(${b*40})`)};
  set(0);return set}
const RC=['#FF5C93','#B01E5A','#FFD4E2'];

/* ====== Hero: la rosa que se abre con resorte ====== */
(()=>{const stage=$('#stage'),svg=$('#roseSvg');const set=makeRose(svg,1.25,RC,true);
  let v=0,vel=0,target=.5,hold=false,done=false,last=0;
  const K=RM?400:110,D=RM?60:17; /* resorte: rigidez y amortiguación */
  function step(t){const dt=Math.min(.032,(t-last)/1000||.016);last=t;const f=-K*(v-target)-D*vel;vel+=f*dt;v+=vel*dt;set(v);
    if(hold&&!done){target=Math.min(1.02,target+dt*(RM?3:.62));}
    if(!done&&v>=.985&&hold){done=true;target=1;stage.classList.add('done');const r=stage.getBoundingClientRect();burst(70,r.left+r.width/2,r.top+r.height*.4);buzz([20,40,20])}
    if(Math.abs(v-target)>.0008||Math.abs(vel)>.002||hold||!done&&target<.5)requestAnimationFrame(step);else raf2=0}
  let raf2=0;const kick=()=>{if(!raf2){last=performance.now();raf2=requestAnimationFrame(step)}};
  /* al cargar: se abre un poco sola, como invitación */
  setTimeout(()=>{target=.5;kick()},120);
  const down=e=>{if(done)return;e&&e.preventDefault&&e.preventDefault();hold=true;if(target<.55)target=.6;kick()};
  const up=()=>{if(!hold)return;hold=false;if(!done)target=.5;kick()};
  stage.addEventListener('pointerdown',down);addEventListener('pointerup',up);addEventListener('pointercancel',up);
  stage.addEventListener('keydown',e=>{if((e.key===' '||e.key==='Enter')&&!hold){e.preventDefault();down()}});stage.addEventListener('keyup',up);
  stage.addEventListener('contextmenu',e=>e.preventDefault());
  window.__setStageName=n=>{$('#stageName').textContent='Para '+(n||'ti')};
  kick()})();
