/* ====== Configurador con vista previa en vivo ====== */
const st={to:'',from:'',msg:'',audio:null,audioName:'',gt:'love',gift:''};
const DEF={to:'Alex',msg:'Gracias por ser la persona que eres. Hoy quería decirte, con mi voz y con estas palabras, cuánto te quiero.'};
const $to=$('#fTo'),$fr=$('#fFrom'),$ms=$('#fMsg');
function render(){const to=st.to.trim(),msg=st.msg.trim(),fr=st.from.trim();
  $('#sWho').textContent=to||DEF.to;$('#pHi').textContent='Para '+(to||DEF.to)+',';
  const m=msg||DEF.msg;$('#sMsg').textContent=m;$('#pMsg').textContent=m;$('#pSig').textContent=fr?'Con cariño, '+fr:'Con cariño';
  $('#fCnt').textContent=st.msg.length+'/400';window.__setStageName&&window.__setStageName(to);
  const GD={money:'$100.000 para ti',plan:'Una cena para dos',gift:'Un regalo te espera',love:'Te quiero muchísimo'};
  $('#gB').textContent=st.gift.trim()||GD[st.gt]}
const GP={money:'Ej: $200.000 para que te consientas',plan:'Ej: Una cena para dos el sábado',gift:'Ej: Un regalo que te espera en casa'};
const $g=$('#fGift');
$$('#gChips .chip').forEach(b=>b.addEventListener('click',()=>{st.gt=b.dataset.g;$$('#gChips .chip').forEach(x=>{const on=x===b;x.classList.toggle('on',on);x.setAttribute('aria-pressed',on)});
  const has=st.gt!=='love';$g.hidden=!has;$('#gNote').hidden=!has;if(has){$g.placeholder=GP[st.gt];$g.focus()}else{st.gift='';$g.value=''}render()}));
$g.addEventListener('input',()=>{st.gift=$g.value;render()});
[[$to,'to'],[$fr,'from'],[$ms,'msg']].forEach(([el,k])=>el.addEventListener('input',()=>{st[k]=el.value;render();if(k==='to')$('#eTo').classList.remove('on');if(k==='msg')$('#eMsg').classList.remove('on')}));
