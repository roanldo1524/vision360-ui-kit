/* ====== Demo: tarjeta que se raspa ====== */
(()=>{const c=$('#scrC'),box=$('#scr');function init(){const r=box.getBoundingClientRect(),d=Math.min(devicePixelRatio||1,2);c.width=r.width*d;c.height=r.height*d;const g=c.getContext('2d');g.scale(d,d);
    const gr=g.createLinearGradient(0,0,r.width,r.height);['#C9A050','#F1D896','#B8893A','#EBCB7F'].forEach((x,i,a)=>gr.addColorStop(i/(a.length-1),x));g.fillStyle=gr;g.fillRect(0,0,r.width,r.height);
    g.globalAlpha=.16;for(let i=0;i<260;i++){g.fillStyle=Math.random()>.5?'#fff':'#000';g.fillRect(Math.random()*r.width,Math.random()*r.height,1.3,1.3)}g.globalAlpha=1;
    g.fillStyle='rgba(255,255,255,.92)';g.font='600 14px Figtree, sans-serif';g.textAlign='center';g.fillText('Raspa aquí',r.width/2,r.height/2+5);
    g.globalCompositeOperation='destination-out';let dw=false,lp=null,n=0,done=false;
    const pt=e=>{const q=c.getBoundingClientRect();return[e.clientX-q.left,e.clientY-q.top]};
    const dr=e=>{const[x,y]=pt(e);g.lineWidth=36;g.lineCap='round';g.beginPath();g.moveTo(...(lp||[x,y]));g.lineTo(x+.1,y+.1);g.stroke();lp=[x,y];if(++n%6===0)chk()};
    function chk(){if(done)return;const a=g.getImageData(0,0,c.width,c.height).data;let k=0;for(let i=3;i<a.length;i+=64)if(a[i]===0)k++;if(k/(a.length/64)>.4){done=true;c.classList.add('off');buzz([15,30,15]);const q=box.getBoundingClientRect();burst(40,q.left+q.width/2,q.top+q.height/2)}}
    c.addEventListener('pointerdown',e=>{dw=true;lp=null;c.setPointerCapture(e.pointerId);dr(e)});c.addEventListener('pointermove',e=>{if(dw)dr(e)});c.addEventListener('pointerup',()=>{dw=false;chk()})}
  const io=new IntersectionObserver(es=>{if(es[0].isIntersecting){io.disconnect();init()}});io.observe(box)})();

/* ====== Demo: velas ====== */
(()=>{const cs=$$('#cndls .c'),wish=$('#wish');let out=0;
  cs.forEach(c=>c.addEventListener('click',()=>{if(c.classList.contains('out'))return;c.classList.add('out');buzz(12);out++;
    if(out===3){wish.textContent='Pide un deseo';wish.classList.add('on');const q=wish.getBoundingClientRect();burst(60,q.left+q.width/2,q.top);setTimeout(()=>{cs.forEach(x=>x.classList.remove('out'));out=0;wish.classList.remove('on')},3600)}}))})();

/* ====== Soplar las velas (micrófono, con alternativa de toque) ====== */
(()=>{const cs=$$('#cndls .c'),wish=$('#wish'),btn=$('#blow');let busy=false;
  const reset=()=>setTimeout(()=>{cs.forEach(x=>x.classList.remove('out'));wish.classList.remove('on');wish.textContent='Pide un deseo';busy=false;btn.disabled=false},3600);
  const done=()=>{wish.textContent='Pide un deseo';wish.classList.add('on');const q=wish.getBoundingClientRect();burst(60,q.left+q.width/2,q.top);reset()};
  btn.addEventListener('click',async()=>{if(busy)return;busy=true;btn.disabled=true;
    let stream;try{stream=await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:false,noiseSuppression:false}})}catch(e){busy=false;btn.disabled=false;toast('No pudimos usar el micrófono. Toca las velas.');return}
    const ac=new (window.AudioContext||window.webkitAudioContext)(),an=ac.createAnalyser();an.fftSize=512;ac.createMediaStreamSource(stream).connect(an);
    const buf=new Uint8Array(an.fftSize);let hot=0,t0=performance.now();wish.textContent='Sopla fuerte, como en una torta';wish.classList.add('on');
    const stop=()=>{stream.getTracks().forEach(t=>t.stop());ac.close()};
    (function loop(){an.getByteTimeDomainData(buf);let m=0;for(let i=0;i<buf.length;i++){const v=Math.abs(buf[i]-128)/128;if(v>m)m=v}
      hot=m>.35?hot+1:Math.max(0,hot-1);
      if(hot>6){const left=cs.filter(c=>!c.classList.contains('out'));if(left.length){left[0].classList.add('out');buzz(12);hot=3}}
      if(cs.every(c=>c.classList.contains('out'))){stop();done();return}
      if(performance.now()-t0>12000){stop();wish.textContent='Toca las velas para apagarlas';busy=false;btn.disabled=false;return}
      requestAnimationFrame(loop)})()})})();

