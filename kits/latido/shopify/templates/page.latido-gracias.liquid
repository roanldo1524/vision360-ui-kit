{% layout none %}{% raw %}<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Gracias · Latido</title><meta name="robots" content="noindex">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Young+Serif&family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--ink:#1C0A20;--rose:#FF5C93;--gold:#F5CF72;--text:#F7EAF1;--soft:#CDB8C6;--ease:cubic-bezier(.23,1,.32,1)}
*{box-sizing:border-box;margin:0}
body{min-height:100svh;background:var(--ink);color:var(--text);font:400 17px/1.6 'Figtree',system-ui,sans-serif;display:grid;place-items:center;padding:28px 20px}
main{width:100%;max-width:460px}
h1{font:400 clamp(32px,9vw,42px)/1.1 'Young Serif',Georgia,serif;letter-spacing:-.02em;text-wrap:balance}
p{color:var(--soft);margin-top:12px}
.card{margin-top:24px;padding:20px;border-radius:24px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.07);box-shadow:0 8px 30px rgba(0,0,0,.25)}
.card b{display:block;color:var(--text);font-weight:600}
ol{margin:12px 0 0 20px;color:var(--soft)}li{margin-top:6px}
.btn{display:flex;align-items:center;justify-content:center;min-height:58px;margin-top:20px;border-radius:99px;background:var(--rose);color:#2A0A1B;font:700 18px/1 'Figtree',sans-serif;text-decoration:none;transition:transform 160ms var(--ease)}
.btn:active{transform:scale(.97)}
small{display:block;margin-top:14px;color:var(--soft);font-size:13px;text-align:center}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style></head><body>
<main>
<h1 id="h">Listo, ya casi está tu sorpresa.</h1>
<p>Recibimos tu pago. Solo falta que nos mandes el audio por WhatsApp.</p>
<div class="card"><b>Haz esto ahora (1 minuto):</b>
<ol><li>Toca el botón verde de abajo.</li><li>Envía el audio que quieres que escuche.</li><li>Si tienes una foto, mándala también.</li></ol>
<a class="btn" id="wa" href="#">Enviar mi audio por WhatsApp</a>
<small>Te la entregamos en máximo 24 horas.</small></div>
</main>
<script>
(function(){
var NUM='573217493251',d={};
try{d=JSON.parse(localStorage.getItem('latido_draft')||'{}')}catch(e){}
var to=(d.to||'').trim(),from=(d.from||'').trim(),msg=(d.msg||'').trim();
if(to)document.getElementById('h').textContent='Listo, la sorpresa para '+to+' va en camino.';
var t='Hola, acabo de pagar mi sorpresa Latido.'+(d.id?' Pedido: '+d.id+'.':'')+(to?'\nPara: '+to:'')+(from?'\nDe parte de: '+from:'')+(msg?'\nMensaje: '+msg:'')+'\nAquí va mi audio:';
document.getElementById('wa').href='https://wa.me/'+NUM+'?text='+encodeURIComponent(t);
})();
</script></body></html>
{% endraw %}