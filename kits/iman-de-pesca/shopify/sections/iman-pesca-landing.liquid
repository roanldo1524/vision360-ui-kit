{%- liquid
  assign rv_count = 0
  assign rv_sum = 0
  for r in shop.metaobjects.resena_cliente.values
    if r.producto.value.id == product.id
      assign rv_count = rv_count | plus: 1
      assign st0 = r.estrellas.value | default: 5
      assign rv_sum = rv_sum | plus: st0
    endif
  endfor
  if rv_count > 0
    assign rv_avg = rv_sum | times: 1.0 | divided_by: rv_count | round: 1
  endif
-%}
