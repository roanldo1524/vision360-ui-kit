  const tone=(f,d,type,vol,when)=>{if(!ac)return;const o=ac.createOscillator(),g=ac.createGain();o.type=type||'square';o.frequency.value=f;g.gain.setValueAtTime(vol||.05,ac.currentTime+(when||0));g.gain.exponentialRampToValueAtTime(.0001,ac.currentTime+(when||0)+d);o.connect(g);g.connect(ac.destination);o.start(ac.currentTime+(when||0));o.stop(ac.currentTime+(when||0)+d+.02)};
