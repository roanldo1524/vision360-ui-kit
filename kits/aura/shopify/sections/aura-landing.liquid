  const confetti=()=>{const c=$('#whConf');c.innerHTML='';const cols=['#E8962E','#9E4413','#23201C','#F7EFE4','#F2A945'];for(let k=0;k<36;k++){const e=document.createElement('i');e.style.left=Math.random()*100+'%';e.style.background=cols[k%5];e.style.animationDelay=(Math.random()*.25)+'s';e.style.setProperty('--dx',(Math.random()*120-60)+'px');e.style.setProperty('--r',(Math.random()*720-360)+'deg');c.appendChild(e)}};
  let ang=0,attempt=0,spinning=false;
  const wrap=$('.wh-wheel',wh)||svg.parentNode;
  const heart=()=>{tone(70,.16,'sine',.09);tone(62,.2,'sine',.08,.2)};
  /* Gira hasta que la flecha quede en el ángulo w de la rueda (0 = arriba, sentido horario) */
  const spinTo=(w,dur,turns,ease,done)=>{const from=ang;const target=from+360*turns+((360-w)-(from%360)+720)%360;const st=performance.now();let lastSeg=Math.floor(from/SA);
    const step=now=>{const t=Math.min(1,(now-st)/dur),e=ease(t);ang=from+(target-from)*e;svg.style.transform='rotate('+ang+'deg)';const sg=Math.floor(ang/SA);if(sg!==lastSeg){lastSeg=sg;sTick();try{navigator.vibrate&&navigator.vibrate(8)}catch(_){}}if(t<1)requestAnimationFrame(step);else done()};requestAnimationFrame(step)};
  const easeOut=t=>1-Math.pow(1-t,4), easeSlow=t=>1-Math.pow(1-t,5), easeIO=t=>t<.5?2*t*t:1-Math.pow(-2*t+2,2)/2;
  const spin=(idx,done)=>{spinning=true;spinTo(idx*SA+SA/2,4800,5,easeOut,()=>{spinning=false;done()})};
  go.onclick=function(){if(spinning)return;unlock();
    attempt++;go.disabled=true;msg.hidden=true;
    track('RuletaGiro',{intento:attempt});
    const after=v=>{go.disabled=false;
      if(!v){sLose();try{navigator.vibrate&&navigator.vibrate(60)}catch(_){}msg.innerHTML='<b>¡Uyyy, casi!</b> Por un pelito no fueron $10.000. Te queda 1 intento. ¡Gíralo!';msg.hidden=false;go.textContent='Girar otra vez';return}
      const p=PR[v];saved={v};try{localStorage.setItem(KEY,JSON.stringify(saved))}catch(_){}const bb=wh.querySelector('.wh-buy');bb.disabled=true;bb.textContent='Aplicando tu descuento…';apply(p).then(()=>{bb.disabled=false;bb.textContent='Pedir con mi descuento'});showChip(p);
      sWin();confetti();try{navigator.vibrate&&navigator.vibrate([60,40,120])}catch(_){}
      $('#whA').textContent=p.t;go.hidden=true;$('#whR').hidden=false;track('RuletaPremio',{premio:v*1000,codigo:p.c,intento:attempt})};
    const pick=Math.random()<.70?5:10;
    const cand=SEG.map((v,i)=>v===pick?i:-1).filter(i=>i>=0);const idx=cand[Math.floor(Math.random()*cand.length)];
    spin(idx,()=>after(SEG[idx]))};
  root.addEventListener('click',e=>{if(e.target.closest('.wh-buy')){track('RuletaPedido',{});setTimeout(close,50)}},true);
});
const __runWheel=()=>{try{__wheel()}catch(_){}};if(document.readyState==='complete')setTimeout(__runWheel,1500);else addEventListener('load',()=>setTimeout(__runWheel,1500),{once:true});
})();
</script>
