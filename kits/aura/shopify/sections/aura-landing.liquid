{% comment %}
  AURA · Landing de producto (lámpara solar mandala, por kits).
  Estructura calcada de lummia.com.co/products/lummiair, con marca propia AURA.
  Reglas: /CLAUDE.md del repo vision360-ui-kit. Todo vive en Shadow DOM para que el tema no lo altere.
{% endcomment %}
{%- liquid
  assign k1 = section.settings.precio_1 | default: 129900
  assign k2 = section.settings.precio_2 | default: 232500
  assign k3 = section.settings.precio_3 | default: 295700
  assign antes = section.settings.precio_antes | default: 220000
-%}
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=Montserrat:wght@500;700;800&display=swap">
<link rel="preload" as="image" href="{{ 'au-sol-patio.png' | file_url }}&width=900">
<style>#es-sticky{opacity:0!important;pointer-events:none!important}#au-apps{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}#au-host{display:block}</style>
<div id="au-apps" aria-hidden="true">{%- for block in section.blocks -%}{%- if block.type == '@app' -%}{% render block %}{%- endif -%}{%- endfor -%}</div>
<div style="display:none">{%- form 'product', product, id: 'au-product-form' -%}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><input type="hidden" name="quantity" value="1">{%- endform -%}</div>
<div id="au-host"></div>
<template id="au-tpl"><style>
:host{all:initial;display:block}
/* ── Tokens ───────────────────────────────────────── */
.ct-page{--ground:#FFFEFC;--sand:#F6EFE6;--sand-2:#EFE5D8;--ink:#23201C;--ink-2:#3A3530;--body:#57514A;--muted:#6B645C;--amber-t:#9A5408;--line:rgba(115,115,115,.10);
  --amber:#E8962E;--amber-2:#F2A945;--amber-ink:#23201C;--warm:#9A9289;
  --gold:#E8962E;--gold-soft:#FBE6C6;--deep:#23201C;--deep-2:#3A3530;--red:#9E4413;--cream:#F6EFE6;--white:#fff;--star:#E8962E;--r:16px;
  --display:'Montserrat',system-ui,sans-serif;--text:'Hanken Grotesk',system-ui,sans-serif;--label:'Hanken Grotesk',system-ui,sans-serif;
  --ease:cubic-bezier(.23,1,.32,1);--sh-1:0 4px 20px -2px rgba(0,0,0,.03),0 2px 8px -1px rgba(0,0,0,.02);--sh-2:0 30px 60px -15px rgba(0,0,0,.10),0 15px 30px -10px rgba(0,0,0,.05);
  font:400 16px/1.6 var(--text);color:var(--ink);background:var(--ground);-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;-webkit-tap-highlight-color:transparent}
.ct-page *,.ct-page *::before,.ct-page *::after{box-sizing:border-box;margin:0;padding:0}
.ct-page img{display:block;max-width:100%;height:auto}
.ct-page button{font:inherit;color:inherit;background:none;border:0;cursor:pointer;-webkit-tap-highlight-color:transparent}
.ct-page a{color:inherit}
.ct-page :focus-visible{outline:2px solid var(--amber);outline-offset:3px;border-radius:6px}
.ct-page .w{width:100%;max-width:1180px;margin:0 auto;padding:0 20px}
.ct-page h1,.ct-page h2,.ct-page h3{font-family:var(--display);color:var(--ink);letter-spacing:-.03em;line-height:1.05}
.ct-page h2{font-size:clamp(26px,6.6vw,44px);font-weight:700}
.ct-page h2 em,.ct-page h1 em{font-style:normal;color:var(--ink-2);font-weight:500;letter-spacing:-.035em}
.ct-page h2 em.a{color:var(--amber-t);font-weight:700}
.ct-page .close h2 em,.ct-page .close h2 em.a{color:var(--amber-2)}
.ct-page .lede{color:var(--body);font-size:16px;line-height:1.55;max-width:46ch}
.ct-page .tag{font:700 11px/1 var(--label);letter-spacing:.15em;text-transform:uppercase}
.ct-page .sec{padding:72px 0}
.ct-page .center{text-align:center}.ct-page .center .lede{margin-left:auto;margin-right:auto}
/* Botones (Emil: 200ms, 0.98 al tocar, 1.01 solo con mouse) */
.ct-page .cta{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;min-height:56px;padding:0 24px;border-radius:999px;background:var(--amber);color:var(--amber-ink);font:700 17px/1 var(--display);letter-spacing:-.01em;box-shadow:none;transition:transform 200ms var(--ease),background-color 200ms ease;text-decoration:none;touch-action:manipulation;user-select:none}
.ct-page .cta:active{transform:scale(.98)}
@media (hover:hover) and (pointer:fine){.ct-page .cta:hover{background:var(--amber-2);transform:scale(1.01)}}
.ct-page .cta .sep{opacity:.45}
.ct-page .cta.gold{background:var(--amber)}
.ct-page .seller{margin:12px auto 0;max-width:42ch;font-size:13px;line-height:1.5;color:var(--muted);text-align:center}.ct-page .seller b{color:var(--ink);font-weight:600}
.ct-page .micro{display:flex;justify-content:center;flex-wrap:wrap;gap:4px 10px;margin-top:10px;font-size:13px;color:var(--muted)}
.ct-page .micro span{display:inline-flex;align-items:center;gap:5px}
.ct-page .micro svg{width:14px;height:14px;stroke:var(--muted)}
/* Entradas al hacer scroll */
.ct-page .rv{transition:opacity 420ms var(--ease),transform 520ms var(--ease)}
.ct-page .info>*{animation:auIn 280ms var(--ease) both}.ct-page .info>*:nth-child(2){animation-delay:30ms}.ct-page .info>*:nth-child(3){animation-delay:60ms}.ct-page .info>*:nth-child(4){animation-delay:90ms}.ct-page .info>*:nth-child(n+5){animation-delay:120ms}
@keyframes auIn{from{opacity:0;transform:translateY(8px)}}
.ct-page .rv.pre{opacity:0;transform:translateY(20px)}
.ct-page .cur{transition:clip-path 900ms cubic-bezier(.77,0,.175,1)}
.ct-page .cur.hide{clip-path:inset(0 0 100% 0)}

/* 1 · Barra superior */
.ct-page .bar{background:var(--ink);color:#EDE6DC;text-align:center;font:600 13px/1 var(--text);padding:11px 16px;letter-spacing:.01em}
.ct-page .bar b{color:var(--amber-2);font-weight:700}
/* 2 · Banner Black Friday */
.ct-page .promo{background:var(--sand);border-bottom:1px solid var(--line)}
.ct-page .promo .w{display:flex;align-items:center;gap:10px;padding-top:8px;padding-bottom:8px}
.ct-page .promo img{width:56px;height:46px;object-fit:cover;border-radius:10px;flex:none}
.ct-page .promo p{flex:1}
.ct-page .promo p span b{font-weight:700;color:var(--ink);font-variant-numeric:tabular-nums}
.ct-page .pbtn{flex:none;background:var(--ink);color:#F7EFE4;font:700 13px/1 var(--display);padding:0 20px;min-height:44px;display:inline-flex;align-items:center;border-radius:999px;transition:transform 160ms var(--ease)}
.ct-page .pbtn:active{transform:scale(.96)}
.ct-page .promo p{font:700 14px/1.2 var(--display);letter-spacing:-.01em;color:var(--ink)}
.ct-page .promo p span{display:block;font:500 13px/1.3 var(--text);color:var(--body);letter-spacing:0}
.ct-page .cd{display:flex;gap:4px}
.ct-page .cd i{font-style:normal;display:grid;place-items:center;min-width:38px;height:40px;border-radius:10px;background:var(--ground);box-shadow:var(--sh-1);border:1px solid var(--line);font:800 15px/1 var(--display);font-variant-numeric:tabular-nums}
.ct-page .cd i small{display:block;font:600 9px/1 var(--label);letter-spacing:.12em;color:var(--muted);margin-top:2px}

/* 3–9 · Bloque de compra */
.ct-page .buy{padding:16px 0 8px}
.ct-page .buy .w{display:grid;gap:22px}
.ct-page .gal{position:relative}
.ct-page .slides{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;border-radius:24px;background:var(--sand);box-shadow:var(--sh-1)}
.ct-page .slides::-webkit-scrollbar{display:none}
.ct-page .slides figure{flex:0 0 100%;scroll-snap-align:center;aspect-ratio:1/1;overflow:hidden}
.ct-page .slides img{width:100%;height:100%;object-fit:cover}
.ct-page .slides figure:first-child img{animation:auOn 1100ms cubic-bezier(.23,1,.32,1) 120ms both,kb 14s var(--ease) both}
@keyframes auOn{from{filter:brightness(.42) saturate(.55)}to{filter:none}}
@keyframes kb{from{transform:scale(1)}to{transform:scale(1.045)}}
.ct-page .seal{position:absolute;top:14px;right:14px;width:74px;height:74px;border-radius:50%;background:rgba(255,254,252,.92);display:grid;place-items:center;box-shadow:var(--sh-1);border:1px solid var(--line)}
.ct-page .seal svg{width:100%;height:100%}
.ct-page .seal text{transform-box:view-box;transform-origin:50px 50px;animation:spin 40s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.ct-page .garr{position:absolute;top:calc(50% - 22px);width:44px;height:44px;border-radius:50%;background:rgba(255,254,252,.94);display:grid;place-items:center;box-shadow:var(--sh-1);transition:transform 200ms var(--ease),opacity 200ms}
.ct-page .garr:active{transform:scale(.92)}.ct-page .garr[disabled]{opacity:0;pointer-events:none}
.ct-page .gprev{left:12px}.ct-page .gnext{right:12px}
.ct-page .garr svg{width:18px;height:18px;stroke:var(--ink)}
.ct-page .gcount{position:absolute;left:14px;bottom:44px;font:700 11px/1 var(--label);letter-spacing:.12em;padding:7px 10px;border-radius:999px;background:rgba(20,18,16,.62);color:#F7EFE4;font-variant-numeric:tabular-nums;pointer-events:none}
.ct-page .dots{display:flex;justify-content:center;gap:6px;margin-top:12px}
.ct-page .dots b{width:7px;height:7px;border-radius:9px;background:#DCD3C7;transition:width 260ms var(--ease),background 260ms}
.ct-page .dots b.on{width:22px;background:var(--amber)}
.ct-page .thumbs{display:none}
/* reseñas cortas */
.ct-page .rq{display:flex;gap:10px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;margin:2px -20px 0;padding:2px 20px 6px}
.ct-page .rq::-webkit-scrollbar{display:none}
.ct-page .rq article{flex:0 0 82%;scroll-snap-align:center;border:1px solid var(--line);border-radius:16px;padding:14px 16px;background:var(--ground);box-shadow:var(--sh-1)}
.ct-page .stars{display:flex;gap:2px;color:var(--star)}.ct-page .stars svg{width:15px;height:15px;fill:currentColor}
.ct-page .rq p{font-size:14px;color:var(--ink-2);margin:6px 0 8px}
.ct-page .rq b{font:600 13px/1 var(--text)}
/* info */
.ct-page .info h1{font-size:clamp(25px,6.4vw,36px);font-weight:700}
.ct-page .info .sub{font:500 16px/1.45 var(--text);color:var(--body);margin-top:8px;max-width:44ch}
.ct-page .price{display:flex;align-items:center;flex-wrap:wrap;gap:6px 10px;margin-top:12px}
.ct-page .price strong,.ct-page .price s,.ct-page .off,.ct-page #btnPrice{transition:filter 160ms var(--ease),opacity 160ms var(--ease)}
.ct-page .swap{filter:blur(2px);opacity:.55}
.ct-page .price strong{font:800 30px/1 var(--display);letter-spacing:-.03em;color:var(--red);font-variant-numeric:tabular-nums}
.ct-page .price s{font:500 18px/1 var(--display);color:var(--muted);font-variant-numeric:tabular-nums}
.ct-page .off{font:700 13px/1 var(--display);color:var(--red);background:#FBEADF;border:1px dashed rgba(180,80,26,.35);border-radius:999px;padding:6px 10px}
.ct-page .pay{display:flex;gap:12px;align-items:center;margin-top:16px;padding:12px 14px;border-radius:16px;background:var(--sand);border:1px solid var(--line)}
.ct-page .pay svg{flex:none;width:34px;height:34px}
.ct-page .pay p{font-size:14px;line-height:1.4;color:var(--ink-2)}
.ct-page .pay b{color:var(--ink)}
.ct-page .pick{margin-top:18px}
.ct-page .pick>p{font:700 15px/1 var(--display);letter-spacing:-.01em;margin-bottom:10px}
.ct-page .pick>p span{font-weight:500;font-family:var(--text);color:var(--body)}
.ct-page .kits{display:flex;gap:12px}
.ct-page .kit{position:relative;display:flex;flex-direction:column;align-items:center;gap:6px;width:76px;transition:transform 200ms var(--ease)}
.ct-page .kit:active{transform:scale(.96)}
.ct-page .kit .ph{width:64px;height:64px;border-radius:50%;overflow:hidden;background:var(--sand);box-shadow:0 0 0 1px var(--line);transition:box-shadow 220ms var(--ease)}
.ct-page .kit .ph img{width:100%;height:100%;object-fit:cover}
.ct-page .kit.on .ph{box-shadow:0 0 0 2px var(--ground),0 0 0 4px var(--ink)}
.ct-page .kit small{font:600 12px/1.2 var(--text);text-align:center;color:var(--ink-2)}
.ct-page .kit small em{display:block;font-style:normal;font-weight:700;font-size:11px;color:var(--red);margin-top:2px;font-variant-numeric:tabular-nums}
.ct-page .kit small b{display:block;font-weight:700;color:var(--ink)}
.ct-page .kit .bd{position:absolute;top:-9px;left:50%;transform:translateX(-50%);white-space:nowrap;font:700 10px/1 var(--label);letter-spacing:.12em;text-transform:uppercase;background:var(--ink);color:var(--amber-2);padding:4px 6px;border-radius:999px}
.ct-page .bens{list-style:none;margin:20px 0 4px;display:grid;gap:10px}
.ct-page .bens li,.ct-page .kit{animation:rise 360ms var(--ease) both}
.ct-page .bens li:nth-child(2),.ct-page .kit:nth-child(2){animation-delay:50ms}.ct-page .bens li:nth-child(3),.ct-page .kit:nth-child(3){animation-delay:100ms}.ct-page .bens li:nth-child(4){animation-delay:150ms}
@keyframes rise{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.ct-page .bens li{display:flex;gap:12px;align-items:flex-start;font-size:15.5px;line-height:1.45;color:var(--ink-2)}
.ct-page .bens svg{flex:none;width:22px;height:22px;stroke:var(--ink);margin-top:1px}
.ct-page .desc{margin-top:14px;color:var(--ink-2);font-size:16px;max-width:62ch}
.ct-page .desc b{color:var(--ink)}
.ct-page .desc i{display:block;margin-top:10px;color:var(--muted);font-size:14px}
.ct-page .buybtn{margin-top:20px}
/* 10 · Complementa */
.ct-page .comp{margin-top:20px}
.ct-page .comp>p{font:700 15px/1 var(--display);margin-bottom:10px}
.ct-page .up{display:grid;grid-template-columns:96px 1fr;border-radius:16px;overflow:hidden;background:var(--sand);border:1px solid var(--line);box-shadow:var(--sh-1);width:100%;text-align:left;transition:transform 200ms var(--ease)}
.ct-page .up:active{transform:scale(.99)}
.ct-page .up img{width:96px;height:100%;object-fit:cover}
.ct-page .up div{padding:12px 14px;position:relative}
.ct-page .up b{display:block;font:700 14.5px/1.2 var(--display);padding-right:52px}
.ct-page .up em{font-style:normal;display:inline-block;margin:6px 0 4px;font:700 11px/1 var(--label);letter-spacing:.12em;text-transform:uppercase;background:var(--ink);color:var(--amber-2);padding:4px 7px;border-radius:999px}
.ct-page .up span{display:block;font-size:13.5px;color:var(--body)}
.ct-page .sw{position:absolute;top:12px;right:12px;width:42px;height:24px;border-radius:999px;background:#DCD3C7;transition:background 220ms var(--ease)}
.ct-page .sw::after{content:"";position:absolute;top:3px;left:3px;width:18px;height:18px;border-radius:50%;background:#fff;box-shadow:0 2px 6px rgba(0,0,0,.18);transition:transform 260ms var(--ease)}
.ct-page .up[aria-pressed="true"] .sw{background:var(--amber)}
.ct-page .up[aria-pressed="true"] .sw::after{transform:translateX(18px)}

/* 11 · Carrusel "así se ve" */
/* 11 · Coverflow de videos (estructura de Lummia: centro grande, lados al 84% y semitransparentes, 350 ms) */
.ct-page .vc-sec{padding:18px 0 6px;overflow:hidden}
.ct-page .vc{--cw:min(44vw,200px);position:relative;height:calc(var(--cw)*16/9 + 4px);touch-action:pan-y;user-select:none}
.ct-page .vc-track{position:relative;height:100%}
.ct-page .vc-slide{position:absolute;top:0;left:50%;width:var(--cw);margin-left:calc(var(--cw)/-2);transition:transform 350ms var(--ease),opacity 350ms var(--ease),filter 350ms var(--ease);will-change:transform}
.ct-page .vc-card{position:relative;aspect-ratio:9/16;border-radius:12px;overflow:hidden;background:var(--ink);border:1px solid rgba(232,150,46,.35);box-shadow:var(--sh-2)}
.ct-page .vc-card video{width:100%;height:100%;object-fit:cover;display:block}
.ct-page .vc-play{position:absolute;top:8px;right:8px;width:24px;height:24px;border-radius:50%;background:rgba(20,18,16,.45);display:grid;place-items:center;transition:opacity 200ms}
.ct-page .vc-play svg{width:12px;height:12px}
.ct-page .vc-slide.on .vc-play{opacity:0}
.ct-page .vc-cap{position:absolute;left:0;right:0;bottom:0;padding:34px 10px 10px;background:linear-gradient(transparent,rgba(16,14,12,.7));color:#fff;font:700 13.5px/1.25 var(--display);letter-spacing:-.01em;text-align:center}
.ct-page .vc-cap{transition:opacity 250ms var(--ease)}.ct-page .vc-slide:not(.on) .vc-cap{opacity:0}
.ct-page .vc-nav{display:flex;justify-content:center;gap:12px;margin-top:12px}
.ct-page .vc-nav button{width:44px;height:44px;border-radius:50%;border:1px solid rgba(35,32,28,.16);display:grid;place-items:center;color:var(--ink);transition:transform 160ms var(--ease)}
.ct-page .vc-nav button:active{transform:scale(.92)}
.ct-page .vc-nav svg{width:18px;height:18px;stroke:currentColor}
.ct-page #vcSnd .i-on{display:none}.ct-page #vcSnd[aria-pressed="true"] .i-on{display:block}.ct-page #vcSnd[aria-pressed="true"] .i-off{display:none}.ct-page #vcSnd svg{width:20px;height:20px;stroke:currentColor}.ct-page #vcSnd[aria-pressed="true"]{background:var(--ink);color:#F7EFE4;border-color:var(--ink)}
.ct-page #vcPlay .i-play{display:none}.ct-page #vcPlay.paused .i-play{display:block}.ct-page #vcPlay.paused .i-pause{display:none}
/* 12 y 22 · Preguntas (abren con grid 0fr→1fr, sin saltos) */
.ct-page .qa{border-top:1px solid rgba(35,32,28,.10)}
.ct-page .qa details{border-bottom:1px solid rgba(35,32,28,.10)}
.ct-page .qa summary{list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:16px 4px;font:500 16px/1.35 var(--text);color:var(--ink);cursor:pointer}
.ct-page .qa summary::-webkit-details-marker{display:none}
.ct-page .qa summary i{flex:none;position:relative;width:14px;height:14px}
.ct-page .qa summary i::before,.ct-page .qa summary i::after{content:"";position:absolute;left:0;top:6px;width:14px;height:2px;border-radius:2px;background:var(--ink);transition:transform 260ms var(--ease)}
.ct-page .qa summary i::after{transform:rotate(90deg)}
.ct-page .qa details[open] summary i::after{transform:rotate(0)}
.ct-page .qa .a{display:grid;grid-template-rows:0fr;transition:grid-template-rows 300ms var(--ease)}
.ct-page .qa details[open] .a{grid-template-rows:1fr}
.ct-page .qa .a>div{overflow:hidden}
.ct-page .qa .a p{padding:0 4px 16px;color:var(--body);font-size:15px}
.ct-page .short{padding:18px 0 8px}
/* 13 · Día / Noche (lo vivo) */
.ct-page .dn{background:#FBE9D7;padding:64px 0}
.ct-page .dn .lede{margin-top:10px}
.ct-page .dnbox{position:relative;margin:26px auto 0;max-width:520px;aspect-ratio:4/5;border-radius:24px;overflow:hidden;box-shadow:var(--sh-2);touch-action:pan-y;user-select:none}
.ct-page .dnbox img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.ct-page .dnbox .night{clip-path:inset(0 0 0 var(--x,50%));transition:clip-path 0ms}
.ct-page .dnbox.anim .night{transition:clip-path 520ms var(--ease)}
.ct-page .dnbox .knob{position:absolute;top:0;bottom:0;left:var(--x,50%);width:0}
.ct-page .dnbox .knob::before{content:"";position:absolute;top:0;bottom:0;left:-1px;width:2px;background:rgba(255,255,255,.85)}
.ct-page .dnbox .knob button{position:absolute;top:50%;left:0;transform:translate(-50%,-50%);width:52px;height:52px;border-radius:50%;background:#fff;box-shadow:var(--sh-2);display:grid;place-items:center;transition:transform 200ms var(--ease)}
.ct-page .dnbox.anim .knob{transition:left 520ms var(--ease)}
.ct-page .dnbox .knob button:active{transform:translate(-50%,-50%) scale(.94)}
.ct-page .dnbox .knob svg{width:26px;height:26px}
.ct-page .lbl{position:absolute;top:14px;font:700 11px/1 var(--label);letter-spacing:.15em;text-transform:uppercase;padding:8px 12px;border-radius:999px;background:rgba(255,254,252,.9);color:var(--ink)}
.ct-page .lbl.l{left:14px}.ct-page .lbl.r{right:14px;background:rgba(20,18,16,.72);color:#F7EFE4}
.ct-page .dn .note{margin-top:22px;text-align:center}
.ct-page .dn .note b{display:block;font:700 18px/1.25 var(--display);letter-spacing:-.02em}
.ct-page .dn .note p{color:var(--body);font-size:15px;margin-top:6px}
/* 14 · Recomendación real (solo si existe) */
.ct-page .rec{background:#FBE9D7;padding:0 0 64px}
.ct-page .rec .card{max-width:520px;margin:0 auto;background:var(--ground);border-radius:24px;padding:22px;box-shadow:var(--sh-1);border:1px solid var(--line)}
/* 15 · Tabla comparativa */
.ct-page .vs{padding:64px 0}
.ct-page .tbl{margin-top:26px;border-radius:20px;overflow:hidden;background:#F6F3EE;border:1px solid var(--line)}
.ct-page .tbl table{width:100%;border-collapse:collapse;font-size:13px}
